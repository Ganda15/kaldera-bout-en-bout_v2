# Application
APP_ENV=development
LOG_LEVEL=INFO

# Partenaire anti-fraude (A2A)
PARTENAIRE_URL=http://localhost:8100
PARTENAIRE_JETON=jeton-de-demo

# Modèle de langage des agents de lecture (Azure AI Foundry, API Responses compatible OpenAI).
# Copier ce fichier en .env et y mettre la clé : .env est ignoré par Git, la clé ne doit jamais être commitée.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-2
