<mxfile host="app.diagrams.net" type="device"><diagram id="schema-0-arbre-de-decision" name="Arbre de décision du pattern"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Choix du pattern agentique : arbre de décision · Chantier 1" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="st" value="Une question métier, puis cinq questions d&#x27;architecture posées dans l&#x27;ordre ; chaque réponse élimine une option. Réponses fondées sur specs_metier.md et interface.md." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1180" height="22" as="geometry"/></mxCell><mxCell id="q0" value="&lt;b&gt;Q0 · métier&lt;/b&gt; : le recours à un système agentique est-il justifié, au regard d&#x27;un traitement humain ou de règles simples ?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9d2e9;strokeColor=#8e7cc3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="520" height="64" as="geometry"/></mxCell><mxCell id="r0" value="&lt;b&gt;Écarté&lt;/b&gt; : confier une règle à un LLM. Éligibilité, pièces, montant, indicateurs et décision sont chiffrés (§ 4 à § 10) : ils restent en code. L&#x27;avis de fraude vient du partenaire, un agent externe." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="520" height="64" as="geometry"/></mxCell><mxCell id="er0" value="écarte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q0" target="r0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1" value="&lt;b&gt;Q1&lt;/b&gt; : un seul agent avec 10 à 15 outils suffit-il ?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="520" height="64" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Écarté&lt;/b&gt; : l&#x27;agent unique. Ses rôles ne peuvent pas être prouvés séparément ; la trace exige un agent par section." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="230" width="520" height="64" as="geometry"/></mxCell><mxCell id="er1" value="écarte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2" value="&lt;b&gt;Q2&lt;/b&gt; : les étapes sont-elles connues d&#x27;avance, et dans quel ordre ?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="520" height="64" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Écarté&lt;/b&gt; : un planificateur LLM qui invente les étapes. Le parcours est fixé par la spec (§ 2), testable et bornable." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="350" width="520" height="64" as="geometry"/></mxCell><mxCell id="er2" value="écarte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q3" value="&lt;b&gt;Q3&lt;/b&gt; : des sous-tâches peuvent-elles s&#x27;exécuter en parallèle ?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="520" height="64" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Retenu&lt;/b&gt; : éligibilité et vérification des pièces en parallèle ; la demande de complément seulement si la demande est éligible." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="470" width="520" height="64" as="geometry"/></mxCell><mxCell id="er3" value="retient" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q3" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q4" value="&lt;b&gt;Q4&lt;/b&gt; : faut-il un contrôle central qui garantit une décision ou une escalade pour chaque demande ?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="520" height="64" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Écarté&lt;/b&gt; : des agents qui se passent la main sans contrôle central ; personne ne garantirait l&#x27;issue de chaque demande, ni les 10 s." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="590" width="520" height="64" as="geometry"/></mxCell><mxCell id="er4" value="écarte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q4" target="r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q5" value="&lt;b&gt;Q5&lt;/b&gt; : quelles métriques par agent faut-il rendre visibles ?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="520" height="64" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;Ajouté&lt;/b&gt; : une trace à chaque étape (agent, sections écrites), source des métriques par agent." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="710" width="520" height="64" as="geometry"/></mxCell><mxCell id="er5" value="ajoute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q5" target="r5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="final" value="&lt;b&gt;Pattern retenu&lt;/b&gt; : une Coordination centrale en code (pattern superviseur) qui applique les règles de décision, et quatre agents de contrôle, chacun maître d&#x27;une seule section · éligibilité et pièces en parallèle · un seul appel au partenaire par demande · une trace à chaque étape" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="520" height="90" as="geometry"/></mxCell><mxCell id="d0" value="en partie : les règles sont chiffrées, l&#x27;avis de fraude est externe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q0" target="q1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2" value="oui : éligibilité et pièces, estimation, anti-fraude, issue (§ 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2" target="q3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3" value="oui : éligibilité et pièces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q3" target="q4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d4" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q4" target="q5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d5" value="appels, échecs, latence, appels externes (interface.md)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q5" target="final"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tension" value="&lt;b&gt;Tension à arbitrer&lt;/b&gt; : le code est prévisible mais rigide ; un système tout agentique est souple mais difficile à garantir. Ici chaque règle est chiffrée et les engagements sont absolus (issue garantie, 10 s) : un squelette en code, l&#x27;avis externe venant du partenaire." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="700" y="830" width="520" height="90" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#8e7cc3&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Question métier" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="950" width="122" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Question d&#x27;architecture" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="162" y="950" width="173" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Option écartée" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="345" y="950" width="116" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#3d85c6&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Option retenue ou ajoutée" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="471" y="950" width="186" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Tension à arbitrer" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="667" y="950" width="141" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>