<mxfile host="app.diagrams.net" type="device"><diagram id="schema-1-carte-des-agents" name="Carte des agents"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Carte des agents · Chantier 1" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="st" value="Rôles, frontières, point ambigu tranché, dépendances et parallélisme. Fondé sur specs_metier.md (v3.2) et interface.md : une section métier n&#x27;est écrite que par un seul agent, et un agent n&#x27;écrit qu&#x27;une seule section." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1300" height="22" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;Coordination&lt;/b&gt; (code, sans LLM) · &lt;b&gt;écrit : issue&lt;/b&gt; · seule à lire et à écrire l&#x27;état&lt;br&gt;Délègue chaque contrôle, vérifie les bornes, applique les règles de décision dans l&#x27;ordre (spec § 10), conclut la demande. Seule à conclure.&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; refaire un contrôle (éligibilité, pièces, montant, fraude).&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="95" width="700" height="82" as="geometry"/></mxCell><mxCell id="par" value="Exécutés en parallèle : aucun n&#x27;a besoin du résultat de l&#x27;autre" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3d85c6;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Arial;fontSize=11;fontColor=#3d85c6;" vertex="1" parent="1"><mxGeometry x="30" y="225" width="440" height="420" as="geometry"/></mxCell><mxCell id="elig" value="&lt;b&gt;Éligibilité&lt;/b&gt; (règles en code) · &lt;b&gt;section : eligibilite&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vérifie E1 à E5 : contrat actif, cotisations, carence de 30 jours, délai de déclaration, garantie de la formule.&lt;br&gt;Renvoie : éligible oui ou non, conditions non remplies.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; chiffrer la demande, appliquer le plafond, juger les pièces ou la fraude.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="255" width="400" height="175" as="geometry"/></mxCell><mxCell id="pieces" value="&lt;b&gt;Pièces justificatives&lt;/b&gt; (code) · &lt;b&gt;section : pieces&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vérifie présence, lisibilité et type attendu des pièces exigées. Adresse le complément via l&#x27;espace assuré quand la Coordination le lui confie (demande éligible).&lt;br&gt;Renvoie : complet, ou manquantes ; les factures lisibles.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; conclure ou escalader la demande, chiffrer, juger la fraude, décider seul d&#x27;un complément.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="445" width="400" height="185" as="geometry"/></mxCell><mxCell id="estim" value="&lt;b&gt;Estimation&lt;/b&gt; (règles en code) · &lt;b&gt;section : estimation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Montant justifié (factures lisibles), montant retenu (le plus petit des deux), moins la franchise, puis &lt;b&gt;plafond de la formule&lt;/b&gt;.&lt;br&gt;Renvoie : montant justifié et montant estimé.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; juger la fraude, revenir sur l&#x27;éligibilité.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="255" width="360" height="200" as="geometry"/></mxCell><mxCell id="fraude" value="&lt;b&gt;Anti-fraude, liaison avec le partenaire&lt;/b&gt; (code) · &lt;b&gt;section : avis_fraude&lt;/b&gt;&lt;br&gt;&lt;br&gt;Calcule les indicateurs F1 à F4. Si au moins un : un seul appel au partenaire, puis contrôle de sa réponse.&lt;br&gt;Renvoie : non requis, avis (niveau et score), ou indisponible.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; émettre un avis en interne, envoyer une donnée hors contrat, relancer un appel.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1030" y="255" width="360" height="220" as="geometry"/></mxCell><mxCell id="partenaire" value="&lt;b&gt;Partenaire anti-fraude&lt;/b&gt; (agent A2A externe)&lt;br&gt;rend l&#x27;avis : faible, modéré ou élevé · contrat, filtre et mode dégradé : chantier 2" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1045" y="600" width="330" height="80" as="geometry"/></mxCell><mxCell id="ambig" value="&lt;b&gt;Point ambigu tranché : qui applique le plafond ?&lt;/b&gt;&lt;br&gt;&lt;br&gt;La spec range le plafond dans l&#x27;éligibilité (§ 4), mais « le contrôle d&#x27;éligibilité ne chiffre pas » (§ 2), et l&#x27;estimation (§ 6) ne le cite pas. &lt;b&gt;Choix : l&#x27;Estimation&lt;/b&gt;, parce que le plafond est un calcul de montant.&lt;br&gt;&lt;br&gt;&lt;i&gt;Preuve, scénario NOM-05 : 4 200 € déclarés, moins 300 € de franchise = 3 900 €, plafonnés à 3 000 €.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="560" width="460" height="190" as="geometry"/></mxCell><mxCell id="autres" value="&lt;b&gt;Autres frontières tranchées&lt;/b&gt;&lt;br&gt;• Pièces manquantes : constatées par Pièces ; l&#x27;escalade est décidée par la Coordination (règle 2).&lt;br&gt;• Montant justifié : calculé par l&#x27;Estimation (§ 6), à partir des factures lisibles fournies par Pièces.&lt;br&gt;• Indicateurs F1 à F4 : Anti-fraude, après l&#x27;Estimation, car F4 compare le montant déclaré au montant justifié." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="440" height="130" as="geometry"/></mxCell><mxCell id="d1" value="délègue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.06;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="elig"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="205"/><mxPoint x="410" y="205"/></Array></mxGeometry></mxCell><mxCell id="d2" value="délègue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="estim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3" value="délègue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.89;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="fraude"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="215"/><mxPoint x="1210" y="215"/></Array></mxGeometry></mxCell><mxCell id="p1" value="factures lisibles" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="pieces" target="estim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="495" y="540"/><mxPoint x="495" y="400"/></Array></mxGeometry></mxCell><mxCell id="p2" value="montant justifié (pour F4)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="estim" target="fraude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x1" value="si au moins un indicateur" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fraude" target="partenaire"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x2" value="avis à contrôler" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.81;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="partenaire" target="fraude"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1325" y="560"/></Array></mxGeometry></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Code (coordination)" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="148" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#3d85c6&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Agent de contrôle" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="188" y="830" width="135" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Point ambigu tranché" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="332" y="830" width="154" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#cc0000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Frontière : interdit" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="496" y="830" width="154" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Externe ou chantier 2" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="660" y="830" width="160" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="Trait plein : dépendance de données · pointillé vert : délégation · « section » : celle que remplit le résultat de l&#x27;agent, rangé par la Coordination" style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="866" width="900" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>