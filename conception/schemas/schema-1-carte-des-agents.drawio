<mxfile host="app.diagrams.net" type="device"><diagram id="schema-1-carte-des-agents" name="Carte des agents"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Carte des agents · Chantier 1" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="st" value="Rôles, frontières, ordre d&#x27;exécution et point ambigu tranché. Mis à jour le 08/10/2026 : lecture des pièces en amont (phase E), contrôles en séquence avec court-circuit (coordination.derouler) ; la nuit : agent Documents et cohérence (2 bis, spec § 5), dont l&#x27;appel au modèle part dès l&#x27;arrivée du dossier." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1700" height="22" as="geometry"/></mxCell><mxCell id="lect" value="Avant la Coordination · Lecture des pièces (phase E), comprise dans les 10 s de la demande" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="88" width="1720" height="212" as="geometry"/></mxCell><mxCell id="docs" value="&lt;b&gt;Pièces de l&#x27;assuré&lt;/b&gt;, non structurées&lt;br&gt;contrat.pdf · images des pièces jointes (factures, photos, dépôt de plainte) · dépôts de l&#x27;espace assuré · formulaire declaration.json" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="123" width="300" height="160" as="geometry"/></mxCell><mxCell id="lc" value="&lt;b&gt;Lecteur de contrat&lt;/b&gt; (modèle, schéma strict)&lt;br&gt;Texte du PDF : numéro, formule, date, statut, cotisations.&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; décider, deviner un champ.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="123" width="330" height="95" as="geometry"/></mxCell><mxCell id="lp" value="&lt;b&gt;Lecteur de pièces&lt;/b&gt; (netteté en code, puis modèle)&lt;br&gt;Floue : illisible sans appel. Facture nette : montant lu. Dans le doute : illisible.&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; décider, inventer un montant.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="790" y="123" width="330" height="95" as="geometry"/></mxCell><mxCell id="cappel" value="&lt;b&gt;En même temps, dès l&#x27;arrivée : l&#x27;appel de cohérence&lt;/b&gt; (modèle, vision). Images nettes et déclaration, un seul appel ; son résultat attend l&#x27;agent 2 bis, plus bas. Il ne dépend pas de la lecture." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=2;dashed=1;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="400" y="233" width="720" height="50" as="geometry"/></mxCell><mxCell id="json" value="&lt;b&gt;Demande au format § 3&lt;/b&gt;&lt;br&gt;la même que sur le chemin JSON. Contrat lu différent du déclaré, ou modèle en panne : escalade gestionnaire, aucun contrôle lancé." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="123" width="330" height="160" as="geometry"/></mxCell><mxCell id="r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="docs" target="lc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r2" value="numéro&lt;br&gt;conforme" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lc" target="lp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="lp" target="json"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.86;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="docs" target="cappel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r4" value="demande § 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8061;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="json" target="orch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="orch" value="&lt;b&gt;Coordination&lt;/b&gt; (code, sans LLM) · &lt;b&gt;écrit : issue&lt;/b&gt; · seule à lire et à écrire l&#x27;état&lt;br&gt;Délègue chaque contrôle dans l&#x27;ordre, vérifie les bornes, applique les règles de décision (spec § 10) et conclut dès qu&#x27;une règle s&#x27;applique. Seule à conclure.&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; refaire un contrôle (éligibilité, pièces, cohérence, montant, fraude).&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="150" y="330" width="1470" height="78" as="geometry"/></mxCell><mxCell id="elig" value="&lt;b&gt;1 · Éligibilité&lt;/b&gt; (règles en code) · &lt;b&gt;section : eligibilite&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vérifie E1 à E5 : contrat actif, cotisations, carence de 30 jours, délai de déclaration, garantie de la formule.&lt;br&gt;Renvoie : éligible oui ou non, conditions non remplies.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; chiffrer, appliquer le plafond, juger les pièces ou la fraude.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="455" width="290" height="215" as="geometry"/></mxCell><mxCell id="pieces" value="&lt;b&gt;2 · Pièces justificatives&lt;/b&gt; (code) · &lt;b&gt;section : pieces&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vérifie présence, lisibilité (rendue par le Lecteur de pièces) et type attendu. Adresse le complément quand la Coordination le lui confie, 2 fois au plus.&lt;br&gt;Renvoie : complet, ou manquantes ; les factures lisibles.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; conclure, chiffrer, juger la fraude, décider seul d&#x27;un complément.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="455" width="290" height="215" as="geometry"/></mxCell><mxCell id="coh" value="&lt;b&gt;2 bis · Documents et cohérence&lt;/b&gt; (modèle, vision ; verdict en code) · &lt;b&gt;section : coherence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chemin des pièces seulement (§ 5). Le modèle dit à quel sinistre se rapporte chaque pièce nette ; le code vérifie les écarts (autre sinistre, facture antérieure) et rend : cohérent, contradiction, insuffisant ou non effectué.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; refuser, chiffrer, juger la preuve ou la fraude.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="455" width="290" height="215" as="geometry"/></mxCell><mxCell id="estim" value="&lt;b&gt;3 · Estimation&lt;/b&gt; (règles en code) · &lt;b&gt;section : estimation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Montant justifié (factures lisibles), montant retenu (le plus petit des deux), moins la franchise, puis &lt;b&gt;plafond de la formule&lt;/b&gt;.&lt;br&gt;Renvoie : montant justifié et montant estimé.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; juger la fraude, revenir sur l&#x27;éligibilité.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1080" y="455" width="290" height="215" as="geometry"/></mxCell><mxCell id="fraude" value="&lt;b&gt;4 · Anti-fraude, liaison avec le partenaire&lt;/b&gt; (code) · &lt;b&gt;section : avis_fraude&lt;/b&gt;&lt;br&gt;&lt;br&gt;Indicateurs F1 à F4. Si au moins un : un seul appel au partenaire, puis contrôle de sa réponse.&lt;br&gt;Renvoie : non requis, avis (niveau et score), ou indisponible.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; émettre un avis en interne, envoyer une donnée hors contrat, relancer un appel.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1430" y="455" width="290" height="215" as="geometry"/></mxCell><mxCell id="d0" value="délègue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.017006802721088437;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="elig"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.25510204081632654;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="pieces"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.4931972789115646;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="coh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.7312925170068028;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="estim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.9693877551020408;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="fraude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s1" value="si&lt;br&gt;éligible" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="elig" target="pieces"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2" value="si&lt;br&gt;complet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="pieces" target="coh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2b" value="si&lt;br&gt;cohérent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="coh" target="estim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s3" value="si&lt;br&gt;montant&lt;br&gt;&gt; 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="estim" target="fraude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="stop1" value="Non éligible : &lt;b&gt;refusée&lt;/b&gt; (règle 1)&lt;br&gt;les pièces ne sont jamais vérifiées" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="695" width="290" height="62" as="geometry"/></mxCell><mxCell id="stop2" value="Pièces encore manquantes, ou aucun dépôt : &lt;b&gt;escalade gestionnaire&lt;/b&gt; (règle 2)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="380" y="695" width="290" height="62" as="geometry"/></mxCell><mxCell id="stop2b" value="Contradiction, doute ou échec technique : &lt;b&gt;escalade gestionnaire&lt;/b&gt;, avec la pièce en cause" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="730" y="695" width="290" height="62" as="geometry"/></mxCell><mxCell id="stop3" value="Montant nul après la franchise : &lt;b&gt;refusée&lt;/b&gt; (règle 3)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1080" y="695" width="290" height="62" as="geometry"/></mxCell><mxCell id="k1" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6aa84f;strokeWidth=1.5;fontColor=#38761d;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="elig" target="stop1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k2" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pieces" target="stop2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k2b" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="coh" target="stop2b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k3" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6aa84f;strokeWidth=1.5;fontColor=#38761d;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="estim" target="stop3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="partenaire" value="&lt;b&gt;Partenaire anti-fraude&lt;/b&gt; (agent A2A externe)&lt;br&gt;rend l&#x27;avis : faible, modéré ou élevé · contrat, filtre et mode dégradé : chantier 2" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1430" y="720" width="290" height="80" as="geometry"/></mxCell><mxCell id="x1" value="si au moins un indicateur" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fraude" target="partenaire"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x2" value="avis à contrôler" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="partenaire" target="fraude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="autres" value="&lt;b&gt;Autres frontières tranchées&lt;/b&gt;&lt;br&gt;• Pièces manquantes : constatées par Pièces ; l&#x27;escalade est décidée par la Coordination (règle 2).&lt;br&gt;• Montant justifié : calculé par l&#x27;Estimation (§ 6), à partir des factures lisibles fournies par Pièces.&lt;br&gt;• Indicateurs F1 à F4 : Anti-fraude, après l&#x27;Estimation, car F4 compare le montant déclaré au montant justifié.&lt;br&gt;• Cohérence avec la déclaration (§ 5) : sur le chemin JSON, le type des pièces (Pièces) ; sur le chemin des pièces, l&#x27;agent 2 bis, dans sa propre section, hors des cinq sections métier : « pieces » reste à Pièces." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="560" height="160" as="geometry"/></mxCell><mxCell id="ambig" value="&lt;b&gt;Point ambigu tranché : qui applique le plafond ?&lt;/b&gt;&lt;br&gt;&lt;br&gt;La spec range le plafond dans l&#x27;éligibilité (§ 4), mais « le contrôle d&#x27;éligibilité ne chiffre pas » (§ 2), et l&#x27;estimation (§ 6) ne le cite pas. &lt;b&gt;Choix : l&#x27;Estimation&lt;/b&gt;, parce que le plafond est un calcul de montant.&lt;br&gt;&lt;br&gt;&lt;i&gt;Preuve, scénario NOM-05 : 4 200 € déclarés, moins 300 € de franchise = 3 900 €, plafonnés à 3 000 €.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="830" width="520" height="160" as="geometry"/></mxCell><mxCell id="ordre" value="&lt;b&gt;Ordre et court-circuit&lt;/b&gt; (coordination.derouler)&lt;br&gt;1 Éligibilité, 2 Pièces (avec 2 compléments au plus), 2 bis Cohérence (chemin des pièces), 3 Estimation, 4 Anti-fraude. Un contrôle n&#x27;est lancé que si le précédent n&#x27;a pas conclu : une demande non éligible ne fait jamais vérifier ses pièces. C&#x27;est la Coordination qui conclut, jamais l&#x27;agent.&lt;br&gt;Après l&#x27;Anti-fraude : règle 4 (avis modéré ou élevé, mode dégradé), règle 5 (plus de 10 000 € : gestionnaire), règle 6 (acceptée)." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="830" width="580" height="160" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Code (coordination)" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="1020" width="148" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#45818e&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Agent avec modèle" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="188" y="1020" width="135" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#3d85c6&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Agent de contrôle" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="332" y="1020" width="135" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Point ambigu tranché" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="477" y="1020" width="154" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#cc0000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Frontière : interdit" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="641" y="1020" width="154" height="26" as="geometry"/></mxCell><mxCell id="leg5" value="&lt;font color=&quot;#6aa84f&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Décision" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="805" y="1020" width="77" height="26" as="geometry"/></mxCell><mxCell id="leg6" value="&lt;font color=&quot;#bf9000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Escalade" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="892" y="1020" width="77" height="26" as="geometry"/></mxCell><mxCell id="leg7" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Externe ou chantier 2" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="980" y="1020" width="160" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="Trait plein : ordre ou données · pointillé vert : délégation · « section » : celle que remplit le résultat de l&#x27;agent, rangé par la Coordination · agent avec modèle : le modèle lit ou interprète, sa sortie est validée par un schéma strict, le code décide · cadre pointillé : appel lancé à l&#x27;arrivée" style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1056" width="1700" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>