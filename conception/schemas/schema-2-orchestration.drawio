<mxfile host="app.diagrams.net" type="device"><diagram id="schema-2-orchestration" name="Orchestration et terminaison"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1670" pageHeight="1325" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Orchestration et terminaison garantie · Chantier 1" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="st" value="Chaque losange est une règle de décision appliquée par la Coordination, dans l&#x27;ordre de la spec (§ 10) ; la première qui s&#x27;applique fixe l&#x27;issue. Contrôles en séquence (mis à jour le 08/10/2026) : une demande non éligible ne fait jamais vérifier ses pièces. Chaque chemin finit par une décision ou par une escalade motivée." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1300" height="22" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;Demande reçue&lt;/b&gt;&lt;br&gt;état créé, section demande en lecture seule" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="120" y="95" width="300" height="52" as="geometry"/></mxCell><mxCell id="e" value="&lt;b&gt;Éligibilité&lt;/b&gt; (contrôle 1)&lt;br&gt;E1 à E5" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="155" y="172" width="230" height="55" as="geometry"/></mxCell><mxCell id="r1" value="Éligible ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="160" y="255" width="220" height="90" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;DÉCISION : REFUSÉE&lt;/b&gt; · règle 1&lt;br&gt;0 € ; le motif cite les conditions non remplies" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="270" width="340" height="60" as="geometry"/></mxCell><mxCell id="p" value="&lt;b&gt;Pièces&lt;/b&gt; (contrôle 2)&lt;br&gt;présence, lisibilité" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="155" y="375" width="230" height="55" as="geometry"/></mxCell><mxCell id="r2" value="Pièces exigées&lt;br&gt;présentes et lisibles ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="160" y="455" width="220" height="100" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;Pièces : demande de complément&lt;/b&gt; (2 au plus)&lt;br&gt;via l&#x27;espace assuré, puis nouveau contrôle" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="480" y="475" width="340" height="60" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;ESCALADE gestionnaire&lt;/b&gt; · règle 2&lt;br&gt;motif : pièces manquantes" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;align=center;verticalAlign=middle;spacingLeft=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="475" width="300" height="60" as="geometry"/></mxCell><mxCell id="est" value="&lt;b&gt;Estimation&lt;/b&gt;&lt;br&gt;justifié, retenu, franchise, plafond" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="120" y="595" width="300" height="58" as="geometry"/></mxCell><mxCell id="r3" value="Montant estimé&lt;br&gt;nul ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="160" y="685" width="220" height="90" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;DÉCISION : REFUSÉE&lt;/b&gt; · règle 3&lt;br&gt;0 € ; dommage inférieur ou égal à la franchise" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="700" width="340" height="60" as="geometry"/></mxCell><mxCell id="r4" value="Anti-fraude :&lt;br&gt;un indicateur F1 à F4 ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="160" y="810" width="220" height="100" as="geometry"/></mxCell><mxCell id="pa" value="&lt;b&gt;Avis du partenaire&lt;/b&gt; (chantier 2)&lt;br&gt;un seul appel, au plus 3 s dans le temps restant, aucune relance" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="480" y="830" width="340" height="60" as="geometry"/></mxCell><mxCell id="t4a" value="&lt;b&gt;ESCALADE gestionnaire&lt;/b&gt; · avis modéré&lt;br&gt;motif : contrôle renforcé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;align=center;verticalAlign=middle;spacingLeft=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="780" width="300" height="56" as="geometry"/></mxCell><mxCell id="t4b" value="&lt;b&gt;ESCALADE cellule_fraude&lt;/b&gt; · avis élevé&lt;br&gt;motif : suspicion de fraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;align=center;verticalAlign=middle;spacingLeft=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="850" width="300" height="56" as="geometry"/></mxCell><mxCell id="deg" value="&lt;b&gt;Avis indisponible : mode dégradé&lt;/b&gt; (§ 9)&lt;br&gt;délai dépassé, erreur ou réponse non conforme" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="480" y="940" width="340" height="60" as="geometry"/></mxCell><mxCell id="t4c" value="&lt;b&gt;ESCALADE cellule_fraude&lt;/b&gt;&lt;br&gt;montant estimé &amp;gt; 1 500 €, mode dégradé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;align=center;verticalAlign=middle;spacingLeft=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="940" width="300" height="56" as="geometry"/></mxCell><mxCell id="r5" value="Montant estimé&lt;br&gt;&amp;gt; 10 000 € ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="160" y="1045" width="220" height="90" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b&gt;ESCALADE gestionnaire&lt;/b&gt; · règle 5&lt;br&gt;motif : seuil de délégation dépassé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;align=center;verticalAlign=middle;spacingLeft=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="1060" width="340" height="60" as="geometry"/></mxCell><mxCell id="t6" value="&lt;b&gt;DÉCISION : ACCEPTÉE&lt;/b&gt; · règle 6&lt;br&gt;montant remboursé = montant estimé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="1175" width="300" height="60" as="geometry"/></mxCell><mxCell id="bornes" value="&lt;b&gt;Bornes provisoires&lt;/b&gt;&lt;br&gt;vérifiées par la Coordination avant chaque délégation&lt;br&gt;&lt;br&gt;• Durée par demande : &lt;b&gt;10 s&lt;/b&gt;, lecture des pièces comprise (spec § 12)&lt;br&gt;• Étapes par demande : &lt;b&gt;8&lt;/b&gt; au plus (une étape = une délégation = une ligne de trace)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(chemin nominal : 5 ; plus 2 compléments ; plus 1 de marge)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;la dernière étape est réservée à l&#x27;issue : la trace ne dépasse jamais 8&lt;br&gt;• Demandes de complément : &lt;b&gt;2&lt;/b&gt; au plus&lt;br&gt;• Même état vu deux fois : arrêt immédiat&lt;br&gt;• Appel au partenaire : 3 s (contrat § 5) ; contrôle interne : objectif 1 s, non imposé (mesuré : 0,01 ms)&lt;br&gt;• Lot : demandes traitées en concurrence, 10 s chacune (§ 12)&lt;br&gt;&lt;br&gt;&lt;b&gt;Borne atteinte&lt;/b&gt; : ESCALADE gestionnaire, et la fiche le signale dans &lt;i&gt;arret&lt;/i&gt; (nom de la borne).&lt;br&gt;&lt;br&gt;&lt;i&gt;Fondées sur le chemin le plus long prévu par la spec et les scénarios ; le chantier 2 les éprouve (BCL-01, PAN-02), chaque changement entre au journal des ajustements.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;fillColor=#fff2cc;strokeColor=#bf9000;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1240" y="95" width="400" height="390" as="geometry"/></mxCell><mxCell id="qui" value="&lt;b&gt;Qui décide que la demande est terminée ?&lt;/b&gt;&lt;br&gt;La Coordination seule, en écrivant la section issue (« seule la décision conclut la demande », § 2). Aucun autre état final : jamais « en attente » sans qu&#x27;un humain en soit saisi." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="505" width="400" height="110" as="geometry"/></mxCell><mxCell id="comp" value="&lt;b&gt;Pourquoi le complément après l&#x27;éligibilité ?&lt;/b&gt;&lt;br&gt;Une demande non éligible est refusée quel que soit l&#x27;état de ses pièces (règle 1) : inutile de solliciter l&#x27;assuré. La Coordination décide le complément ; Pièces l&#x27;adresse." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="640" width="400" height="100" as="geometry"/></mxCell><mxCell id="a1" value="délègue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b1" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6aa84f;strokeWidth=1.5;fontColor=#38761d;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b2" value="oui : délègue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="p"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b2b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b3" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell i