<mxfile host="app.diagrams.net" type="device"><diagram id="schema-4-arbre-liaison-a2a" name="Arbre de décision de la liaison A2A"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Choix de la liaison avec le partenaire : arbre de décision · Chantier 2" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="st" value="Une question métier, puis cinq questions de conception posées dans l&#x27;ordre ; chaque réponse élimine une option. Réponses fondées sur contrat.md (v2.0) et specs_metier.md." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1180" height="22" as="geometry"/></mxCell><mxCell id="q0" value="&lt;b&gt;Q0 · métier&lt;/b&gt; : un avis de fraude interne pourrait-il remplacer le partenaire ?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9d2e9;strokeColor=#8e7cc3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="520" height="64" as="geometry"/></mxCell><mxCell id="r0" value="&lt;b&gt;Écarté&lt;/b&gt; : un avis interne. « L&#x27;avis de fraude est émis par le partenaire, jamais en interne » (§ 2) ; Kaldera décide seulement s&#x27;il faut le demander (F1 à F4)." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="520" height="64" as="geometry"/></mxCell><mxCell id="er0" value="écarte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q0" target="r0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1" value="&lt;b&gt;Q1&lt;/b&gt; : le partenaire peut-il recevoir toutes les données de la demande ?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="520" height="64" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Retenu&lt;/b&gt; : un message neuf, construit depuis une liste blanche de sept champs, validé contre un schéma strict avant l&#x27;envoi [E3]." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="230" width="520" height="64" as="geometry"/></mxCell><mxCell id="er1" value="retient" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2" value="&lt;b&gt;Q2&lt;/b&gt; : comment appeler le partenaire ?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="520" height="64" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Écarté&lt;/b&gt; : l&#x27;envoi sans attente suivi de lectures d&#x27;état et d&#x27;une annulation ; le contrat n&#x27;en prévoit pas. Un seul message/send, au plus 3 s, limité par le budget restant de la demande." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="350" width="520" height="64" as="geometry"/></mxCell><mxCell id="er2" value="écarte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q3" value="&lt;b&gt;Q3&lt;/b&gt; : peut-on relancer un appel en échec ?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="520" height="64" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Écarté&lt;/b&gt; : toute relance (contrat § 6). Le registre des appels bloque un second appel dans une même exécution (demande ou lot) ; après un redémarrage, non couvert : limite écrite." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="470" width="520" height="64" as="geometry"/></mxCell><mxCell id="er3" value="écarte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q3" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q4" value="&lt;b&gt;Q4&lt;/b&gt; : une réponse bien formée est-elle forcément exploitable ?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="520" height="64" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Ajouté&lt;/b&gt; : une validation à cinq niveaux (transport, enveloppe, forme A2A, schéma, cohérence) ; toute réponse non conforme est écartée, jamais recopiée [E4]." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="590" width="520" height="64" as="geometry"/></mxCell><mxCell id="er4" value="ajoute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q4" target="r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q5" value="&lt;b&gt;Q5&lt;/b&gt; : que devient la demande sans avis exploitable ?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="520" height="64" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;Retenu&lt;/b&gt; : la règle du § 9 pour toutes les causes : 1 500 € ou moins, la demande continue en mode dégradé ; au-delà, escalade cellule_fraude [E5]." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="710" width="520" height="64" as="geometry"/></mxCell><mxCell id="er5" value="retient" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q5" target="r5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="final" value="&lt;b&gt;Liaison retenue&lt;/b&gt; : un seul point de sortie (l&#x27;agent Anti-fraude) · filtre en liste blanche, sept champs · un appel unique, au plus 3 s, limité par le budget restant · aucune relance · validation à cinq niveaux · une règle de mode dégradé unique" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="520" height="90" as="geometry"/></mxCell><mxCell id="d0" value="non : le partenaire est imposé (§ 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q0" target="q1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1" value="non : sept champs exactement (contrat § 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2" value="un seul message/send, qui rend une tâche terminée" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2" target="q3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3" value="non, jamais (contrat § 6)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q3" target="q4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d4" value="non : il peut répondre hors contrat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q4" target="q5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d5" value="la règle du mode dégradé (§ 9)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q5" target="final"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tension" value="&lt;b&gt;Tension à arbitrer&lt;/b&gt; : une validation stricte écarte plus de réponses et sollicite davantage le mode dégradé ; une validation souple laisse passer des réponses douteuses. Le contrat tranche : une réponse non conforme est écartée, jamais exploitée ; la continuité vient du mode dégradé." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="700" y="830" width="520" height="90" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#8e7cc3&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Question métier" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="950" width="122" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Question de conception" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="162" y="950" width="167" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Option écartée" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="339" y="950" width="116" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#3d85c6&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Option retenue ou ajoutée" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="464" y="950" width="186" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Tension à arbitrer" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="660" y="950" width="141" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>