<mxfile host="app.diagrams.net" type="device"><diagram id="schema-5-echange-a2a" name="Échange A2A et mode dégradé"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Échange A2A, filtre, validation et mode dégradé · Chantier 2" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="st" value="Un seul point de sortie vers le partenaire : rien ne sort hors des sept champs du contrat, rien n&#x27;entre sans validation, rien ne dépasse l&#x27;échéance de la demande. Aligné sur le code du 08/10/2026 (a2a/filtre.py, a2a/client.py, a2a/validation.py, coordination.py)." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1480" height="22" as="geometry"/></mxCell><mxCell id="kaldera" value="Système Kaldera" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="1070" height="975" as="geometry"/></mxCell><mxCell id="externe" value="Partenaire anti-fraude (externe)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#f7f7f7;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1120" y="95" width="390" height="975" as="geometry"/></mxCell><mxCell id="demande" value="&lt;b&gt;Demande&lt;/b&gt; (§ 3)&lt;br&gt;assuré, contrat, sinistre, pièces, historique ; lue seulement par la Coordination&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Ne part jamais&lt;/b&gt; : nom, prénom, e-mail, téléphone, adresse, code postal complet, IBAN, identifiant client, numéro de contrat, description, pièces&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="260" height="165" as="geometry"/></mxCell><mxCell id="af" value="&lt;b&gt;Agent Anti-fraude&lt;/b&gt; · section avis_fraude&lt;br&gt;reçoit 8 données ; calcule F1 à F4.&lt;br&gt;&lt;b&gt;Aucun indicateur&lt;/b&gt; : avis non requis, aucun appel, jamais marqué mode dégradé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="280" height="95" as="geometry"/></mxCell><mxCell id="coord" value="&lt;b&gt;Coordination&lt;/b&gt;&lt;br&gt;seule à lire et écrire l&#x27;état ; donne à l&#x27;agent un accès au partenaire limité au temps restant ; registre des appels : une référence, un appel par exécution" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="130" width="290" height="110" as="geometry"/></mxCell><mxCell id="d0" value="Délai du partenaire&lt;br&gt;≥ 0,1 s ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="255" width="200" height="95" as="geometry"/></mxCell><mxCell id="filtre" value="&lt;b&gt;Filtre sortant [E3]&lt;/b&gt;&lt;br&gt;message neuf : les sept champs du contrat, dont deux calculés (ancienneté, département) ; schéma strict" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="375" width="280" height="110" as="geometry"/></mxCell><mxCell id="appel" value="&lt;b&gt;Appel unique&lt;/b&gt; · POST /a2a, message/send&lt;br&gt;Bearer PARTENAIRE_JETON&lt;br&gt;délai = min(3 s, échéance − maintenant) · aucune relance · réponse arrivée après l&#x27;échéance : jamais lue" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="280" width="290" height="115" as="geometry"/></mxCell><mxCell id="valid" value="&lt;b&gt;Validation de la réponse [E4]&lt;/b&gt;, cinq niveaux dans l&#x27;ordre&lt;br&gt;1. transport : HTTP 200 (503, 401 : écartée)&lt;br&gt;2. JSON et enveloppe JSON-RPC : 2.0, même id, result ; un HTTP 200 qui porte error reste une erreur (INV-06, INV-07, doublon -32029)&lt;br&gt;3. forme A2A : tâche completed, un artefact, une partie data&lt;br&gt;4. schéma : six champs exactement, score de 0 à 1, valeurs permises (INV-01, INV-03, INV-05)&lt;br&gt;5. cohérence : même dossier, niveau cohérent avec le score (INV-02, INV-04)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="430" width="290" height="205" as="geometry"/></mxCell><mxCell id="d1" value="Avis conforme reçu&lt;br&gt;avant l&#x27;échéance&lt;br&gt;autorisée ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="755" y="665" width="220" height="110" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;Avis retenu&lt;/b&gt;, rangé par la Coordination&lt;br&gt;fiche : niveau et score (§ 11) ; evaluation_id gardé dans la section avis_fraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;align=center;verticalAlign=middle;spacingTop=0;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="805" width="290" height="75" as="geometry"/></mxCell><mxCell id="regle4" value="&lt;b&gt;Règle 4&lt;/b&gt; : faible poursuit · modéré gestionnaire · élevé cellule_fraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="720" y="905" width="290" height="70" as="geometry"/></mxCell><mxCell id="indispo" value="&lt;b&gt;Avis indisponible&lt;/b&gt;&lt;br&gt;budget épuisé, requête refusée, doublon, délai dépassé, erreur (503, 401, -32xxx) ou réponse écartée ; la raison (code court) va dans la trace, jamais le contenu reçu" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="700" width="280" height="110" as="geometry"/></mxCell><mxCell id="dd" value="Montant estimé&lt;br&gt;≤ 1 500 € ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="840" width="200" height="90" as="geometry"/></mxCell><mxCell id="cont" value="&lt;b&gt;La demande continue&lt;/b&gt; sans avis&lt;br&gt;règles 5 et 6 · marquée mode dégradé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;align=center;verticalAlign=middle;spacingTop=0;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="960" width="280" height="80" as="geometry"/></mxCell><mxCell id="journal" value="&lt;b&gt;Trace&lt;/b&gt;, écrite par la Coordination&lt;br&gt;agent, action, durée, statut, appel externe, raison d&#x27;une indisponibilité (delai_depasse, schema, http_503…) ; jamais le message, le jeton ni le contenu d&#x27;une réponse écartée" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="260" height="150" as="geometry"/></mxCell><mxCell id="budget" value="&lt;b&gt;Échéance de la demande&lt;/b&gt;&lt;br&gt;arrivée + 10 s − 0,5 s de réserve pour la fiche (déduite une seule fois).&lt;br&gt;Délai du partenaire = min(3 s, échéance − maintenant).&lt;br&gt;&lt;i&gt;Exemple : contrôles finis à 8 s, il reste 1,5 s : le partenaire reçoit 1,5 s, pas 3 s (schéma 7).&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="505" width="225" height="190" as="geometry"/></mxCell><mxCell id="esc" value="&lt;b&gt;ESCALADE cellule_fraude&lt;/b&gt;&lt;br&gt;contrôle anti-fraude manuel · mode dégradé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;align=center;verticalAlign=middle;spacingTop=0;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="260" height="70" as="geometry"/></mxCell><mxCell id="note" value="Jamais de relance (contrat § 6). Doublon dans une même exécution (demande ou lot) : bloqué par le registre, aucun appel. Après un redémarrage : non couvert (limite écrite) ; le partenaire répond -32029, traité comme une erreur." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="945" width="260" height="110" as="geometry"/></mxCell><mxCell id="partenaire" value="&lt;b&gt;Partenaire anti-fraude&lt;/b&gt;&lt;br&gt;agent A2A · Agent Card en /.well-known/agent.json" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1140" y="285" width="350" height="90" as="geometry"/></mxCell><mxCell id="contrat" value="&lt;b&gt;Contrat v2.0&lt;/b&gt;&lt;br&gt;• requête : une partie data, sept champs exactement&lt;br&gt;• réponse : tâche completed, six champs&lt;br&gt;• niveau : faible &amp;lt; 0,40 ≤ modéré &amp;lt; 0,75 ≤ élevé&lt;br&gt;• réponse garantie en 2 s ; abandon au plus tard 3 s après l&#x27;envoi, plus tôt si l&#x27;échéance de la demande l&#x27;exige&lt;br&gt;• un appel par dossier, aucune relance&lt;br&gt;• erreurs : 401, 503, -32700, -32600, -32601, -32602, -32029" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="560" width="350" height="190" as="geometry"/></mxCell><mxCell id="x1" value="lit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="demande" target="coord"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="112"/><mxPoint x="865" y="112"/></Array></mxGeometry></mxCell><mxCell id="x2" value="8 données" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="af"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x2b" value="résultat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="af" target="coord"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x3" value="indicateur présent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="af" target="d0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x3b" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d0" target="filtre"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x3c" value="non : aucun appel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.36;entryDx=0;entryDy=0;" edge="1" parent="1" source="d0" target="indispo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="302"/><mxPoint x="350" y="740"/></Array></mxGeometry></mxCell><mxCell id="x4" value="7 champs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.52;entryDx=0;entryDy=0;" edge="1" parent="1" source="filtre" target="appel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="430"/><mxPoint x="690" y="340"/></Array></mxGeometry></mxCell><mxCell id="x4b" value="refusé : aucun appel réseau" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="filtre" target="indispo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x5" value="message/send" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="appel" target="partenaire"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x6" value="réponse ou erreur" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="partenaire" target="valid"><mxGeometry r