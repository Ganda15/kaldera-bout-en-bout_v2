<mxfile host="app.diagrams.net" type="device"><diagram id="schema-5-echange-a2a" name="Échange A2A et mode dégradé"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Échange A2A, filtre, validation et mode dégradé · Chantier 2" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="st" value="Un seul point de sortie vers le partenaire : rien ne sort hors des sept champs du contrat, rien n&#x27;entre sans validation. Fondé sur contrat.md (v2.0) et specs_metier.md (§ 7, § 9, § 10)." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1450" height="22" as="geometry"/></mxCell><mxCell id="kaldera" value="Système Kaldera" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="1070" height="960" as="geometry"/></mxCell><mxCell id="externe" value="Partenaire anti-fraude (externe)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#f7f7f7;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1120" y="95" width="390" height="960" as="geometry"/></mxCell><mxCell id="demande" value="&lt;b&gt;Demande&lt;/b&gt; (§ 3)&lt;br&gt;assuré, contrat, sinistre, pièces, historique ; lue seulement par la Coordination&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Ne part jamais&lt;/b&gt; : nom, prénom, e-mail, téléphone, adresse, code postal complet, IBAN, identifiant client, numéro de contrat, description, pièces&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="260" height="165" as="geometry"/></mxCell><mxCell id="af" value="&lt;b&gt;Agent Anti-fraude&lt;/b&gt; · section : avis_fraude&lt;br&gt;reçoit 8 données ; calcule F1 à F4 ; aucun indicateur : avis non requis, aucun appel" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="280" height="85" as="geometry"/></mxCell><mxCell id="coord" value="&lt;b&gt;Coordination&lt;/b&gt;&lt;br&gt;seule à lire et écrire l&#x27;état ; écrit le marqueur d&#x27;appel, puis appelle l&#x27;agent" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="130" width="290" height="85" as="geometry"/></mxCell><mxCell id="filtre" value="&lt;b&gt;Filtre sortant [E3]&lt;/b&gt;&lt;br&gt;message neuf : exactement les sept champs du contrat, dont deux calculés (ancienneté, département) ; validé contre un schéma strict ; en cas d&#x27;échec, rien ne part" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="255" width="280" height="135" as="geometry"/></mxCell><mxCell id="appel" value="&lt;b&gt;Appel unique&lt;/b&gt; · POST /a2a, message/send&lt;br&gt;Bearer PARTENAIRE_JETON&lt;br&gt;délai : 3 s au plus, et jamais au-delà des 10 s de la demande · aucune relance" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="270" width="290" height="110" as="geometry"/></mxCell><mxCell id="journal" value="&lt;b&gt;Trace&lt;/b&gt;&lt;br&gt;agent, durée, statut, raison d&#x27;un échec, evaluation_id ; jamais le message, le jeton ni une réponse écartée" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="345" width="260" height="130" as="geometry"/></mxCell><mxCell id="valid" value="&lt;b&gt;Validation de la réponse [E4]&lt;/b&gt;, cinq niveaux dans l&#x27;ordre&lt;br&gt;1. transport : HTTP 200, JSON lisible (INV-06)&lt;br&gt;2. enveloppe JSON-RPC : 2.0, même id, result (INV-07)&lt;br&gt;3. forme A2A : tâche completed, partie data&lt;br&gt;4. schéma : six champs exactement, valeurs permises (INV-03, INV-05)&lt;br&gt;5. cohérence : même dossier, score entre 0 et 1, niveau cohérent avec le score (INV-04, INV-01, INV-02)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="430" width="290" height="200" as="geometry"/></mxCell><mxCell id="d1" value="Avis conforme&lt;br&gt;et reçu à temps ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="765" y="665" width="200" height="100" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;avis_fraude&lt;/b&gt; rangé par la Coordination&lt;br&gt;niveau, score, indicateurs, evaluation_id (audit), version_modele" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;align=center;verticalAlign=middle;spacingTop=0;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="680" width="280" height="70" as="geometry"/></mxCell><mxCell id="regle4" value="&lt;b&gt;Coordination, règle 4&lt;/b&gt;&lt;br&gt;faible : poursuit · modéré : gestionnaire · élevé : cellule_fraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="260" height="70" as="geometry"/></mxCell><mxCell id="indispo" value="&lt;b&gt;Avis indisponible&lt;/b&gt;&lt;br&gt;délai dépassé, erreur (503, 401, -32xxx) ou réponse écartée ; seule la raison est gardée, jamais le contenu reçu" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="800" width="290" height="95" as="geometry"/></mxCell><mxCell id="dd" value="Montant estimé&lt;br&gt;≤ 1 500 € ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="410" y="805" width="200" height="90" as="geometry"/></mxCell><mxCell id="esc" value="&lt;b&gt;ESCALADE cellule_fraude&lt;/b&gt;&lt;br&gt;contrôle anti-fraude manuel · mode dégradé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;align=center;verticalAlign=middle;spacingTop=0;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="815" width="260" height="70" as="geometry"/></mxCell><mxCell id="cont" value="&lt;b&gt;La demande continue&lt;/b&gt; sans avis&lt;br&gt;règles 5 et 6 · décision marquée mode dégradé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;align=center;verticalAlign=middle;spacingTop=0;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="935" width="260" height="75" as="geometry"/></mxCell><mxCell id="note" value="Jamais de relance (contrat § 6). Une réponse tardive n&#x27;est pas lue : l&#x27;appel est abandonné. Le dossier n&#x27;est jamais rappelé (doublon : -32029, manquement). Les erreurs 401 et -32xxx déclenchent une alerte." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="925" width="290" height="110" as="geometry"/></mxCell><mxCell id="partenaire" value="&lt;b&gt;Partenaire anti-fraude&lt;/b&gt;&lt;br&gt;agent A2A · Agent Card en /.well-known/agent.json" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1140" y="275" width="350" height="90" as="geometry"/></mxCell><mxCell id="contrat" value="&lt;b&gt;Contrat v2.0&lt;/b&gt;&lt;br&gt;• requête : une partie data, sept champs exactement&lt;br&gt;• réponse : tâche completed, six champs&lt;br&gt;• niveau : faible &amp;lt; 0,40 ≤ modéré &amp;lt; 0,75 ≤ élevé&lt;br&gt;• réponse garantie en 2 s ; abandon à 3 s&lt;br&gt;• un appel par dossier, aucune relance&lt;br&gt;• erreurs : 401, 503, -32700, -32600, -32601, -32602, -32029" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="560" width="350" height="175" as="geometry"/></mxCell><mxCell id="x1" value="lit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="demande" target="coord"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="112"/><mxPoint x="865" y="112"/></Array></mxGeometry></mxCell><mxCell id="x2" value="8 données" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="af"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x2b" value="résultat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.78;exitDx=0;exitDy=0;entryX=0;entryY=0.78;entryDx=0;entryDy=0;" edge="1" parent="1" source="af" target="coord"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x3" value="indicateur présent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="af" target="filtre"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x4" value="7 champs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.52;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="filtre" target="appel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x5" value="message/send" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="appel" target="partenaire"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x6" value="réponse ou erreur" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="partenaire" target="valid"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1245" y="480"/></Array></mxGeometry></mxCell><mxCell id="x7" value="fin de l&#x27;attente" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="appel" target="valid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="valid" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x9" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6aa84f;strokeWidth=1.5;fontColor=#38761d;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ok" target="regle4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x11" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="indispo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x12" value="§ 9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="indispo" target="dd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x13" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd" target="esc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x14" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6aa84f;strokeWidth=1.5;fontColor=#38761d;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd" target="cont"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x15" value="trace" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="valid" target="journal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="530"/><mxPoint x="350" y="410"/></Array></mxGeometry></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Contrôle écrit en code" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="1080" width="167" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#3d85c6&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Agent" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="207" y="1080" width="58" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Partenaire externe" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="275" y="1080" width="141" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#6aa84f&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Suite normale" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="426" y="1080" width="109" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#bf9000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Chemin de repli" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="545" y="1080" width="122" height="26" as="geometry"/></mxCell><mxCell id="leg5" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Avis indisponible" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="677" y="1080" width="135" height="26" as="geometry"/></mxCell><mxCell id="leg6" value="&lt;font color=&quot;#cc0000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Données interdites" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="822" y="1080" width="141" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>