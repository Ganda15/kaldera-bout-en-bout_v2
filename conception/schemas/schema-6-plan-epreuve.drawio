<mxfile host="app.diagrams.net" type="device"><diagram id="schema-6-plan-epreuve" name="Plan d&#x27;épreuve"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1430" pageHeight="1212" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Plan d&#x27;épreuve : scénarios × signaux × ajustements · Chantier 2" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="st" value="Chaque famille de eval/scenarios.jsonl est rejouée par traiter_lot contre le partenaire simulé fourni ; ses signaux sont comparés au champ attendu. Colonne « mesuré » : outils/mesurer_epreuve.py et tests/integration, le 08/10/2026." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1380" height="22" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;1. Rejouer&lt;/b&gt; un scénario&lt;br&gt;traiter_lot, partenaire simulé : normal, lent, invalide ou panne" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="240" height="85" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;2. Observer&lt;/b&gt; les signaux&lt;br&gt;issue, trace (avec la raison d&#x27;un échec), appels, durées" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="340" y="105" width="240" height="85" as="geometry"/></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;3. Comparer&lt;/b&gt; au champ attendu&lt;br&gt;et aux critères du tableau" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="620" y="105" width="240" height="85" as="geometry"/></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;4. Ajuster&lt;/b&gt; le chantier 1&lt;br&gt;une borne, une frontière ou un routage, un seul à la fois" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="900" y="105" width="240" height="85" as="geometry"/></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1"