ll><mxCell id="h1" value="Exigences" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#d9ead3;strokeColor=#2E6B3E;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="260" width="90" height="40" as="geometry"/></mxCell><mxCell id="l0c1" value="E1, E2" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="300" width="90" height="50" as="geometry"/></mxCell><mxCell id="l1c1" value="E1, E3" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="350" width="90" height="50" as="geometry"/></mxCell><mxCell id="l2c1" value="E4, E5" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="400" width="90" height="50" as="geometry"/></mxCell><mxCell id="l3c1" value="E5, E6" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="450" width="90" height="50" as="geometry"/></mxCell><mxCell id="l4c1" value="E5, E6" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;r