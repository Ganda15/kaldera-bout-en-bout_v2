1"><mxGeometry x="380" y="400" width="290" height="50" as="geometry"/></mxCell><mxCell id="l3c2" value="appels, échecs, issues du lot" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="450" width="290" height="50" as="geometry"/></mxCell><mxCell id="l4c2" value="durée des appels, des demandes, du lot" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="500" width="290" height="50" as="geometry"/></mxCell><mxCell id="l5c2" value="longueur de la trace, arret" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="550" width="290" height="50" as="geometry"/></mxCell><mxCell id="h3" value="Critère de réussite" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#d9ead3;strokeColor=#2E6B3E;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="260" width="420" height="40" as="geometry"/></mxCell><mxCell id="l0c3" value="11 fiches conformes ; chaque section écrite par son seul propriétaire ; 0 appel au partenaire" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="300" width="420" height="50" as="geometry"/></mxCell><mxCell id="l1c3" value="7 appels, 0 échec ; sept champs exactement ; niveau d&#x27;avis et issue conformes" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="350" width="420" height="50" as="geometry"/></mxCell><mxCell id="l2c3" value="7 réponses écartées au bon niveau ; aucun avis recopié ; 1 500 € ou moins continue, au-delà cellule_fraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="400" width="420" height="50" as="geometry"/></mxCell><mxCell id="l3c3" value="2 appels, 2 échecs, 0 relance ; 0401 et 0405 non touchés ; 5 fiches conformes" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="450" width="420" height="50" as="geometry"/></mxCell><mxCell id="l4c3" value="abandon à 3 s ; chaque demande sous 10 s ; le lot dure environ 3 s, pas 6 s" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="500" width="420" height="50" as="geometry"/></mxCell><mxCell id="l5c3" value="escalade avec arret ; trace de 8 étapes au plus" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="550" width="420" height="50" as="geometry"/></mxCell><mxCell id="h4" value="Ajustement possible du chantier 1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#d9ead3;strokeColor=#2E6B3E;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="260" width="270" height="40" as="geometry"/></mxCell><mxCell id="l0c4" value="frontière (droits), etapes_max" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="300" width="270" height="50" as="geometry"/></mxCell><mxCell id="l1c4" value="routage des règles 4 et 5" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="350" width="270" height="50" as="geometry"/></mxCell><mxCell id="l2c4" value="règles de validation" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="400" width="270" height="50" as="geometry"/></mxCell><mxCell id="l3c4" value="routage du mode dégradé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="450" width="270" height="50" as="geometry"/></mxCell><mxCell id="l4c4" value="duree_max_s, lot en concurrence" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="500" width="270" height="50" as="geometry"/></mxCell><mxCell id="l5c4" value="etapes_max, même état, file" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="550" width="270" height="50" as="geometry"/></mxCell><mxCell id="note" value="Aucun LLM dans le chemin de décision et un partenaire simulé déterministe : un rejeu suffit pour juger une issue ; les scénarios de panne sont rejoués cinq fois pour mesurer les durées. Hors scénarios, des tests unitaires couvrent le filtre (données sensibles, Corse, outre-mer), les erreurs 401, 503, -32602, -32029 et la reprise avec marqueur d&#x27;appel. Sur les 28 scénarios : 18 appels au partenaire, jamais deux pour un même dossier." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="1300" height="66" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Étape de contrôle" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="716" width="135" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Ajustement du chantier 1" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="175" y="716" width="180" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Journal des ajustements" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="364" y="716" width="173" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>