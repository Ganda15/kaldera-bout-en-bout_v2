<mxfile host="app.diagrams.net" type="device"><diagram id="schema-7-budget-10-s" name="Budget de 10 s et replis"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="810" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Un budget de 10 secondes, deux chemins de repli · Chantiers 1 et 2" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1250" height="30" as="geometry"/></mxCell><mxCell id="st" value="Une seule échéance par demande, posée à l&#x27;arrivée du dossier. Exemple illustratif : les durées sont choisies pour l&#x27;explication, ce n&#x27;est pas une mesure." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1250" height="22" as="geometry"/></mxCell><mxCell id="seg1" value="&lt;b&gt;Lecture des pièces&lt;/b&gt;, puis Éligibilité, Pièces et Estimation" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;align=center;verticalAlign=middle;spacingTop=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="960" height="60" as="geometry"/></mxCell><mxCell id="seg2" value="&lt;b&gt;Partenaire&lt;/b&gt;&lt;br&gt;1,5 s au plus" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;align=center;verticalAlign=middle;spacingTop=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="180" height="60" as="geometry"/></mxCell><mxCell id="seg3" value="fiche" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;align=center;verticalAlign=middle;spacingTop=0;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="60" height="60" as="geometry"/></mxCell><mxCell id="tk0" value="0 s" style="text;html=1;fontFamily=Arial;fontSize=11;fontColor=#555555;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="60" height="20" as="geometry"/></mxCell><mxCell id="tk8" value="8 s" style="text;html=1;fontFamily=Arial;fontSize=11;fontColor=#555555;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="990" y="165" width="60" height="20" as="geometry"/></mxCell><mxCell id="tk9.5" value="9,5 s" style="text;html=1;fontFamily=Arial;fontSize=11;fontColor=#555555;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1170" y="165" width="60" height="20" as="geometry"/></mxCell><mxCell id="tk10" value="10 s" style="text;html=1;fontFamily=Arial;fontSize=11;fontColor=#555555;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1230" y="165" width="60" height="20" as="geometry"/></mxCell><mxCell id="explic" value="&lt;b&gt;0 s&lt;/b&gt; : le dossier arrive ; échéance = 10 s − 0,5 s de réserve pour la fiche, soit 9,5 s.&lt;br&gt;&lt;b&gt;8 s&lt;/b&gt; : lecture et contrôles finis ; un indicateur F1 à F4 demande l&#x27;avis du partenaire.&lt;br&gt;&lt;b&gt;8 à 9,5 s&lt;/b&gt; : le partenaire reçoit min(3 s, 9,5 − 8) = 1,5 s, et non 3 s.&lt;br&gt;&lt;b&gt;9,5 à 10 s&lt;/b&gt; : la Coordination produit la fiche, avec l&#x27;avis conforme ou le repli prévu." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="1200" height="95" as="geometry"/></mxCell><mxCell id="g_titre" value="Repli 1 · chantier 1" style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="560" height="30" as="geometry"/></mxCell><mxCell id="lect" value="&lt;b&gt;Lecture impossible&lt;/b&gt;&lt;br&gt;modèle en panne, délai dépassé pendant la lecture, contrat illisible" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="355" width="560" height="70" as="geometry"/></mxCell><mxCell id="lect_fin" value="&lt;b&gt;ESCALADE gestionnaire&lt;/b&gt;, motif technique&lt;br&gt;aucune décision sur des données incomplètes ; la règle des 1 500 € ne s&#x27;applique pas" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;align=center;verticalAlign=middle;spacingTop=0;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="560" height="75" as="geometry"/></mxCell><mxCell id="l1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lect" target="lect_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_titre" value="Repli 2 · chantier 2" style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="560" height="30" as="geometry"/></mxCell><mxCell id="avis" value="&lt;b&gt;Avis anti-fraude indisponible&lt;/b&gt;, alors que le contrôle était requis&lt;br&gt;budget épuisé, requête refusée, délai, erreur ou réponse écartée" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="355" width="560" height="70" as="geometry"/></mxCell><mxCell id="dd7" value="Montant estimé&lt;br&gt;≤ 1 500 € ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="450" width="200" height="90" as="geometry"/></mxCell><mxCell id="cont7" value="&lt;b&gt;Continue&lt;/b&gt;, marquée mode dégradé&lt;br&gt;règles 5 et 6" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;align=center;verticalAlign=middle;spacingTop=0;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="570" width="260" height="65" as="geometry"/></mxCell><mxCell id="esc7" value="&lt;b&gt;ESCALADE cellule_fraude&lt;/b&gt;&lt;br&gt;contrôle manuel" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;align=center;verticalAlign=middle;spacingTop=0;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="570" width="260" height="65" as="geometry"/></mxCell><mxCell id="a1" value="§ 9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="avis" target="dd7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6aa84f;strokeWidth=1.5;fontColor=#38761d;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd7" target="cont7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd7" target="esc7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pourquoi" value="&lt;b&gt;Pourquoi deux traitements ?&lt;/b&gt; Sans lecture fiable, aucun montant n&#x27;est sûr : un humain reprend. Sans avis du partenaire, les contrôles sont faits et le montant est connu : la spec (§ 9) prévoit la règle des 1 500 €. Sans indicateur, aucun avis n&#x27;est demandé : jamais de mode dégradé. Échéance déjà dépassée avant l&#x27;Anti-fraude : escalade gestionnaire par la borne duree_max_s." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="665" width="1200" height="80" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Code" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="770" width="52" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#45818e&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Agent de lecture" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="92" y="770" width="128" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Partenaire externe" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="230" y="770" width="141" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Avis indisponible" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="381" y="770" width="135" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#6aa84f&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Suite normale" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="526" y="770" width="109" height="26" as="geometry"/></mxCell><mxCell id="leg5" value="&lt;font color=&quot;#bf9000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Escalade" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="645" y="770" width="77" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>