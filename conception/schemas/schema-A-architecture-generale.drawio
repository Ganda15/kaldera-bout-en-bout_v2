<mxfile host="app.diagrams.net" type="device"><diagram id="schema-A-architecture-generale" name="Architecture générale"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="945" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Architecture générale · Chantier 1" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="st" value="Une seule vue : l&#x27;entrée, la Coordination, les contrôles, la mémoire partagée de la demande, les échanges avec l&#x27;extérieur et les deux issues possibles. Mis à jour le 08/10/2026 : contrôles en séquence, lecture des pièces en amont (schéma E) ; la nuit : agent Documents et cohérence (2 bis, § 5)." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1500" height="22" as="geometry"/></mxCell><mxCell id="lot" value="&lt;b&gt;Entrée&lt;/b&gt; : une demande JSON, ou un dossier lu par les deux agents de lecture (schéma E) ; l&#x27;appel de cohérence part dès l&#x27;arrivée. Chaque demande a son état et ses 10 s ; un lot est traité en parallèle (§ 12)." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="250" height="100" as="geometry"/></mxCell><mxCell id="coord" value="&lt;b&gt;Coordination&lt;/b&gt; (code, sans LLM) · &lt;b&gt;seule à lire et à écrire la mémoire&lt;/b&gt;&lt;br&gt;Appelle chaque agent avec ses entrées, reçoit son résultat et le range ; vérifie les bornes avant chaque délégation (8 étapes, 10 s, 2 compléments), lance les contrôles dans l&#x27;ordre (1, 2, 2 bis sur le chemin des pièces, 3, 4), arrête dès qu&#x27;une règle du § 10 conclut, et conclut seule. Les agents ne s&#x27;appellent jamais entre eux." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="1010" height="80" as="geometry"/></mxCell><mxCell id="grp" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3d85c6;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Arial;fontSize=11;fontColor=#3d85c6;" vertex="1" parent="1"><mxGeometry x="320" y="210" width="1100" height="225" as="geometry"/></mxCell><mxCell id="contrat" value="&lt;b&gt;Contrôles déterministes&lt;/b&gt; (cadre bleu) : un contrat fixe, entrée, sortie, erreurs. Réalisés en code ; la réalisation peut changer sans toucher à la Coordination ni à la mémoire. &lt;b&gt;Cadre cyan&lt;/b&gt; : un modèle interprète, un schéma strict valide, le code décide." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="395" width="170" height="185" as="geometry"/></mxCell><mxCell id="ae" value="&lt;b&gt;1 · Éligibilité&lt;/b&gt; · &lt;b&gt;section : eligibilite&lt;/b&gt;&lt;br&gt;E1 contrat actif, E2 cotisations, E3 carence 30 j, E4 délai de déclaration, E5 garantie.&lt;br&gt;&lt;i&gt;Règles simples : un statut, une date, une liste.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="206" height="165" as="geometry"/></mxCell><mxCell id="dae" value="appel + entrées" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.0019801980198019802;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="ae"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rae" value="résultat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.08316831683168317;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ae" target="coord"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ap" value="&lt;b&gt;2 · Pièces justificatives&lt;/b&gt; · &lt;b&gt;section : pieces&lt;/b&gt;&lt;br&gt;Présence, lisibilité, type attendu ; adresse le complément confié par la Coordination.&lt;br&gt;&lt;i&gt;Les images sont lues en amont, par le lecteur de pièces.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="554" y="250" width="206" height="165" as="geometry"/></mxCell><mxCell id="dap" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.21386138613861386;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="ap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rap" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.29504950495049503;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ap" target="coord"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac" value="&lt;b&gt;2 bis · Documents et cohérence&lt;/b&gt; · &lt;b&gt;section : coherence&lt;/b&gt;&lt;br&gt;Chemin des pièces (§ 5) : chaque pièce nette se rapporte-t-elle au sinistre déclaré ?&lt;br&gt;&lt;i&gt;Le modèle interprète, le code rend le verdict ; appel lancé à l&#x27;arrivée.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="768" y="250" width="206" height="165" as="geometry"/></mxCell><mxCell id="dac" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.42574257425742573;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="ac"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rac" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.5069306930693069;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ac" target="coord"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aes" value="&lt;b&gt;3 · Estimation&lt;/b&gt; · &lt;b&gt;section : estimation&lt;/b&gt;&lt;br&gt;Montant justifié, retenu, estimé ; franchise ; plafond de la formule.&lt;br&gt;&lt;i&gt;Calcul : jamais confié à un LLM.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="982" y="250" width="206" height="165" as="geometry"/></mxCell><mxCell id="daes" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.6376237623762376;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="aes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="raes" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7188118811881188;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="aes" target="coord"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="af" value="&lt;b&gt;4 · Anti-fraude&lt;/b&gt; · &lt;b&gt;section : avis_fraude&lt;/b&gt;&lt;br&gt;Indicateurs F1 à F4 ; un seul appel au partenaire ; contrôle de sa réponse.&lt;br&gt;&lt;i&gt;Seuils en code ; le jugement vient du partenaire.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1196" y="250" width="206" height="165" as="geometry"/></mxCell><mxCell id="daf" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.8495049504950495;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="af"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="raf" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.9306930693069307;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="af" target="coord"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mem" value="Mémoire partagée de la demande : un objet par demande ; seule la Coordination la lit et l&#x27;écrit ; chaque section reçoit le résultat d&#x27;un seul agent" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;verticalAlign=bottom;spacingBottom=6;align=right;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="320" y="450" width="1100" height="250" as="geometry"/></mxCell><mxCell id="selig" value="&lt;b&gt;eligibilite&lt;/b&gt;&lt;br&gt;résultat d&#x27;Éligibilité" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="340" y="490" width="206" height="60" as="geometry"/></mxCell><mxCell id="spieces" value="&lt;b&gt;pieces&lt;/b&gt;&lt;br&gt;résultat de Pièces, après chaque dépôt" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="554" y="490" width="206" height="60" as="geometry"/></mxCell><mxCell id="scoh" value="&lt;b&gt;coherence&lt;/b&gt;&lt;br&gt;hors des 5 sections métier" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="768" y="490" width="206" height="60" as="geometry"/></mxCell><mxCell id="sestim" value="&lt;b&gt;estimation&lt;/b&gt;&lt;br&gt;résultat d&#x27;Estimation" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="982" y="490" width="206" height="60" as="geometry"/></mxCell><mxCell id="sfraude" value="&lt;b&gt;avis_fraude&lt;/b&gt;&lt;br&gt;résultat d&#x27;Anti-fraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1196" y="490" width="206" height="60" as="geometry"/></mxCell><mxCell id="sissue" value="&lt;b&gt;issue&lt;/b&gt;&lt;br&gt;décision ou escalade, motif" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="335" y="590" width="260" height="70" as="geometry"/></mxCell><mxCell id="sctrl" value="&lt;b&gt;hors de l&#x27;état&lt;/b&gt;&lt;br&gt;échéance de la demande, registre des appels (une exécution)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="605" y="590" width="260" height="70" as="geometry"/></mxCell><mxCell id="sdem" value="&lt;b&gt;demande&lt;/b&gt;&lt;br&gt;données reçues, lecture seule" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="875" y="590" width="260" height="70" as="geometry"/></mxCell><mxCell id="strace" value="&lt;b&gt;trace&lt;/b&gt;, ajout seul&lt;br&gt;agent, section remplie, durée, statut" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1145" y="590" width="260" height="70" as="geometry"/></mxCell><mxCell id="wcoord" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="mem"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="164"/><mxPoint x="305" y="525"/></Array></mxGeometry></mxCell><mxCell id="e0" value="une demande" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="lot" target="coord"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="espace" value="&lt;b&gt;Espace assuré&lt;/b&gt;&lt;br&gt;reçoit la demande de complément ; renvoie les dépôts de l&#x27;assuré (§ 5)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="240" height="95" as="geometry"/></mxCell><mxCell id="x0" value="complément" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ap" target="espace"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="232"/><mxPoint x="285" y="232"/><mxPoint x="285" y="297"/></Array></mxGeometry></mxCell><mxCell id="part" value="&lt;b&gt;Partenaire anti-fraude&lt;/b&gt;&lt;br&gt;agent externe, A2A&lt;br&gt;7 champs filtrés, 1 appel, au plus 3 s dans le temps restant&lt;br&gt;(chantier 2)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1460" y="250" width="170" height="120" as="geometry"/></mxCell><mxCell id="x1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="af" target="part"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="metr" value="&lt;b&gt;Métriques par agent&lt;/b&gt;&lt;br&gt;appels, échecs, latence, appels externes (interface.md)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1460" y="590" width="170" height="90" as="geometry"/></mxCell><mxCell id="x2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="strace" target="metr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fiche" value="&lt;b&gt;Fiche de décision&lt;/b&gt; (§ 11)&lt;br&gt;construite depuis issue, avis_fraude, trace et arret" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="740" width="260" height="80" as="geometry"/></mxCell><mxCell id="o1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sissue" target="fiche"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ok" value="&lt;b&gt;Décision&lt;/b&gt;&lt;br&gt;acceptée (montant) ou refusée, avec un motif" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="745" width="300" height="70" as="geometry"/></mxCell><mxCell id="esc" value="&lt;b&gt;Escalade motivée&lt;/b&gt; vers une file humaine&lt;br&gt;gestionnaire ou cellule_fraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1000" y="745" width="405" height="70" as="geometry"/></mxCell><mxCell id="o2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6aa84f;strokeWidth=1.5;fontColor=#38761d;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fiche" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fiche" target="esc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="835"/><mxPoint x="1200" y="835"/></Array></mxGeometry></mxCell><mxCell id="degr" value="&lt;b&gt;Mode dégradé&lt;/b&gt; (§ 9)&lt;br&gt;pas d&#x27;avis en 3 s : 1 500 € ou moins, la demande poursuit, marquée ; au-delà, cellule_fraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1460" y="700" width="170" height="130" as="geometry"/></mxCell><mxCell id="o4" value="&gt; 1 500 €" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="degr" target="esc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pourquoi" value="&lt;b&gt;Pourquoi des agents, si les contrôles sont des règles ?&lt;/b&gt;&lt;br&gt;• Chaque agent rend un service sans montrer ses règles : si la carence passe de 30 à 45 jours, seul l&#x27;agent Éligibilité change.&lt;br&gt;• Une section, un propriétaire : la frontière se prouve dans la trace [E2].&lt;br&gt;• Le modèle sert là où il faut interpréter un document : la lecture, et la cohérence avec la déclaration (2 bis) ; aucune règle chiffrée ne lui est confiée." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="375" width="260" height="230" as="geometry"/></mxCell><mxCell id="comm" value="&lt;b&gt;Comment ils communiquent&lt;/b&gt;&lt;br&gt;Aucun agent ne lit la mémoire. Agents internes : fonctions appelées par la Coordination, dans le même processus. Partenaire : A2A, par le réseau. Un contrôle tenu par un autre service passerait par une API ou une interface d&#x27;agent." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="260" height="175" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Coordination et ses sections" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="875" width="205" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#3d85c6&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Agent de contrôle et sa section" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="245" y="875" width="224" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#45818e&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Agent avec modèle et sa section" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="480" y="875" width="224" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Choix d&#x27;architecture" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="714" y="875" width="154" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Externe ou chantier 2" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="878" y="875" width="160" height="26" as="geometry"/></mxCell><mxCell id="leg5" value="&lt;font color=&quot;#bf9000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Escalade" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="1048" y="875" width="77" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="Pointillé vert : appel avec ses entrées · trait plein : résultat rendu, ou lecture et rangement de la mémoire par la Coordination · pointillé gris : échange avec l&#x27;extérieur" style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="911" width="900" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>