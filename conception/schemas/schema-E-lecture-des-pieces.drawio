<mxfile host="app.diagrams.net" type="device"><diagram id="schema-E-lecture-des-pieces" name="Lecture des pièces"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Lecture des pièces : du document au JSON de la spec § 3 · Phase E" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="st" value="Les agents de lecture lisent et extraient, ils ne décident jamais. Le code teste d&#x27;abord ce qu&#x27;il sait tester ; le modèle ne lit que ce que le code ne sait pas lire ; sa réponse passe par un schéma strict. La chaîne de décision du chantier 1 reste inchangée." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1540" height="22" as="geometry"/></mxCell><mxCell id="dos" value="Dossier de l&#x27;assuré (dossiers/KAL-26-0101)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="300" height="600" as="geometry"/></mxCell><mxCell id="f_decl" value="&lt;b&gt;declaration.json&lt;/b&gt;&lt;br&gt;formulaire : référence, assuré, sinistre, historique, numéro de contrat déclaré" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="135" width="270" height="80" as="geometry"/>