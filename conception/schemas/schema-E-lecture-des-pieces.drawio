;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddoute" target="p_dout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="panne" value="&lt;b&gt;Modèle en panne, délai ou réponse hors schéma&lt;/b&gt; → ExtractionImpossible&lt;br&gt;&lt;b&gt;Escalade gestionnaire&lt;/b&gt; motivée, aucun contrôle lancé. Une panne n&#x27;est pas la faute de l&#x27;assuré : on ne lui demande pas de complément." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="360" y="735" width="560" height="105" as="geometry"/></mxCell><mxCell id="json" value="&lt;b&gt;Demande au format § 3&lt;/b&gt;&lt;br&gt;contrat lu, pièces et dépôts lus, formulaire ; identique à ce que reçoit le chemin JSON" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="735" width="300" height="105" as="geometry"/></mxCell><mxCell id="chaine" value="&lt;b&gt;Chaîne du chantier 1, inchangée&lt;/b&gt;&lt;br&gt;coordination.traiter : Éligibilité, Pièces, Estimation, Anti-fraude, règles § 10, fiche de décision" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1280" y="735" width="290" height="105" as="geometry"/></mxCell><mxCell id="gpan" value="lecture impossible (contrat ou facture)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.3232;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gp" target="panne"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gjs" value="contrat, pièces et dépôts lus" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5496;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gp" target="json"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="form" value="formulaire (declaration.json)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dos" target="json"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="315" y="875"/><mxPoint x="1100" y="875"/></Array></mxGeometry></mxCell><mxCell id="entree" value="&lt;b&gt;Avant toute lecture : escalade gestionnaire&lt;/b&gt; motivée si le formulaire est absent ou illisible, le contrat absent, corrompu ou sans texte, ou un fichier non reconnu. Jamais d&#x27;erreur brute." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="30" y="735" width="270" height="105" as="geometry"/></mxCell><mxCell id="dent" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dos" target="entree"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jch" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="json" target="chaine"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="garde" value="&lt;b&gt;Garde-fous&lt;/b&gt;&lt;br&gt;• Le texte d&#x27;un document est une donnée, jamais une consigne : phrase de garde dans chaque consigne, document entre balises.&lt;br&gt;• Clé dans .env, jamais dans le code ni dans Git ; aucune relance automatique.&lt;br&gt;• Un seul budget de 10 s par demande, lecture comprise : chaque appel au modèle reçoit le temps restant comme délai ; à court de temps, escalade technique. Lecture tracée à part." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="760" height="110" as="geometry"/></mxCell><mxCell id="mesure" value="&lt;b&gt;Mesure E4&lt;/b&gt; (08/10/2026, 34 dossiers, gpt-5.4)&lt;br&gt;100 % sur chaque champ (5 du contrat, 33 montants, 68 lisibilités) · 34/34 décisions identiques au chemin JSON · 0 lecture impossible · 67 appels en 24,8 s (6 dossiers lus à la fois) · facture : moyenne 2,38 s, max 5,89 s · 32 180 jetons en entrée, 2 480 en sortie.&lt;br&gt;&lt;i&gt;Limites : documents de synthèse et propres ; 2 images illisibles seulement, attrapées par le code ; le contenu des photos n&#x27;est pas vérifié.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="810" y="900" width="760" height="110" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Code, sans modèle" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="1030" width="135" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#45818e&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Modèle, schéma strict" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="175" y="1030" width="160" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#6aa84f&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Suite normale" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="345" y="1030" width="109" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#bf9000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Escalade gestionnaire" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="464" y="1030" width="160" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Mesure" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="635" y="1030" width="64" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="Losange : test en code · note : résultat de lecture · « illisible » mène à une demande de complément (règle 2) ; une panne mène à une escalade, jamais à une demande faite à l&#x27;assuré" style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1066" width="1400" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>