<mxfile host="app.diagrams.net" type="device"><diagram id="schema-N0-enjeux-exigences" name="Niveau 0 · Enjeux et exigences"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Pourquoi : le problème métier et les six exigences · Niveau 0" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="st" value="Ce que le client vit aujourd&#x27;hui, ce qui a changé chez le partenaire, et les six exigences de la direction des opérations, avec ce qui tient chacune dans la conception." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1440" height="22" as="geometry"/></mxCell><mxCell id="avant" value="&lt;b&gt;Avant : un seul agent généraliste&lt;/b&gt;&lt;br&gt;&lt;br&gt;Il mélange les rôles : personne ne peut vérifier qui a décidé quoi.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Partenaire muet : la demande reste bloquée, parfois des semaines, et personne n&#x27;est prévenu.&lt;/b&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#f8d7da;strokeColor=#cc0000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="650" height="140" as="geometry"/></mxCell><mxCell id="contrat" value="&lt;b&gt;Le partenaire a durci son contrat (version 2.0)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Schéma strict · exactement 7 champs, aucune donnée d&#x27;identité, de coordonnées ni bancaire · un seul appel par dossier, aucune relance · réponse garantie en 2 s.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#38761d&quot;&gt;&lt;b&gt;Objectif : une issue pour chaque demande en 10 s, même partenaire en panne, prouvée sur 28 scénarios.&lt;/b&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="650" height="165" as="geometry"/></mxCell><mxCell id="reponse" value="&lt;b&gt;La réponse de la conception&lt;/b&gt;&lt;br&gt;• une Coordination en code, quatre contrôles en code et des agents avec modèle pour les documents : lecture et cohérence avec la déclaration (niveau 1, chantier 1)&lt;br&gt;• une mémoire de session lue et écrite par la seule Coordination&lt;br&gt;• une liaison A2A filtrée et validée, avec un mode dégradé (niveau 1, chantier 2)&lt;br&gt;• un plan d&#x27;épreuve de 28 scénarios, et un journal des ajustements (niveau 2)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="445" width="650" height="150" as="geometry"/></mxCell><mxCell id="cE1" value="&lt;font style=&quot;font-size:26px&quot; color=&quot;#b45f06&quot;&gt;&lt;b&gt;E1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Toute demande se termine par une décision ou une escalade humaine motivée, jamais par un blocage silencieux.&lt;br&gt;&lt;br&gt;&lt;i&gt;Tenu par : les règles du § 10 dans l&#x27;ordre et les bornes, signalées dans arret.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#b45f06;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="370" height="150" as="geometry"/></mxCell><mxCell id="cE2" value="&lt;font style=&quot;font-size:26px&quot; color=&quot;#b45f06&quot;&gt;&lt;b&gt;E2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Chaque agent a un rôle et une frontière définis ; aucun agent n&#x27;empiète sur le rôle d&#x27;un autre.&lt;br&gt;&lt;br&gt;&lt;i&gt;Tenu par : une section par agent, rangée par la Coordination ; la trace (agent, ecrit).&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#b45f06;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="100" width="370" height="150" as="geometry"/></mxCell><mxCell id="cE3" value="&lt;font style=&quot;font-size:26px&quot; color=&quot;#b45f06&quot;&gt;&lt;b&gt;E3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Seules les données prévues au contrat partent chez le partenaire, rien d&#x27;autre.&lt;br&gt;&lt;br&gt;&lt;i&gt;Tenu par : huit données passées à l&#x27;agent Anti-fraude, puis un filtre de 7 champs.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#b45f06;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="265" width="370" height="150" as="geometry"/></mxCell><mxCell id="cE4" value="&lt;font style=&quot;font-size:26px&quot; color=&quot;#b45f06&quot;&gt;&lt;b&gt;E4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Une réponse du partenaire non conforme au contrat est rejetée, jamais propagée telle quelle.&lt;br&gt;&lt;br&gt;&lt;i&gt;Tenu par : une validation à cinq niveaux ; seule la raison du rejet est gardée.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#b45f06;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="265" width="370" height="150" as="geometry"/></mxCell><mxCell id="cE5" value="&lt;font style=&quot;font-size:26px&quot; color=&quot;#b45f06&quot;&gt;&lt;b&gt;E5&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Partenaire indisponible : le mode dégradé défini par le métier s&#x27;applique.&lt;br&gt;&lt;br&gt;&lt;i&gt;Tenu par : § 9 : 1 500 € ou moins, la demande poursuit ; au-delà, cellule_fraude.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#b45f06;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="430" width="370" height="150" as="geometry"/></mxCell><mxCell id="cE6" value="&lt;font style=&quot;font-size:26px&quot; color=&quot;#b45f06&quot;&gt;&lt;b&gt;E6&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Aucune boucle infinie ; métriques par agent visibles ; tout ajustement provoqué par l&#x27;épreuve est consigné.&lt;br&gt;&lt;br&gt;&lt;i&gt;Tenu par : les bornes, quatre métriques par agent, le journal des ajustements.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#b45f06;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="430" width="370" height="150" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#cc0000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Le problème" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="96" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Le contrat du partenaire" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="136" y="610" width="180" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;La réponse de la conception" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="326" y="610" width="199" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Une exigence et ce qui la tient" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="535" y="610" width="224" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>