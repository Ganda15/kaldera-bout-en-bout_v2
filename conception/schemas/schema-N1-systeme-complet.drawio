<mxfile host="app.diagrams.net" type="device"><diagram id="schema-N1-systeme-complet" name="Niveau 1 · Système complet"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Le système complet : l&#x27;équipe, la liaison A2A et le partenaire · Niveau 1" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="st" value="Un dossier de pièces est lu à gauche (phase E, ajoutée le 08/10/2026) ; la Coordination appelle chaque agent dans l&#x27;ordre, avec ses seules entrées, et range son résultat ; si un indicateur de fraude est présent, un seul appel part chez le partenaire, à travers le filtre et la validation." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1900" height="22" as="geometry"/></mxCell><mxCell id="ch1" value="Chantier 1 · L&#x27;équipe et son orchestration" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="1150" height="835" as="geometry"/></mxCell><mxCell id="ch2" value="Chantier 2 · La liaison A2A (côté Kaldera)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1195" y="95" width="435" height="835" as="geometry"/></mxCell><mxCell id="ext" value="Partenaire (externe)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#f7f7f7;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1650" y="95" width="330" height="835" as="geometry"/></mxCell><mxCell id="recv" value="&lt;b&gt;Lecture des pièces&lt;/b&gt; (phase E)&lt;br&gt;Lecteurs de contrat et de pièces : modèle, schéma strict, demande § 3 (ou JSON déjà prêt). Un état par demande." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="230" height="105" as="geometry"/></mxCell><mxCell id="coord" value="&lt;b&gt;Coordination · superviseur&lt;/b&gt; (code, sans LLM) &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E1] [E2] [E6]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Appelle chaque agent directement avec ses seules entrées, reçoit son résultat et le range dans sa section ; seule à lire et à écrire l&#x27;état. Vérifie les bornes avant chaque appel, applique les règles du § 10 dans l&#x27;ordre, conclut. Ne refait jamais un contrôle." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="135" width="560" height="125" as="geometry"/></mxCell><mxCell id="bornes" value="&lt;b&gt;Bornes&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E1] [E6]&lt;/b&gt;&lt;/font&gt;, vérifiées avant chaque appel&lt;br&gt;• 10 s par demande (§ 12)&lt;br&gt;• 8 étapes, la dernière réservée à l&#x27;issue&lt;br&gt;• 2 demandes de complément&lt;br&gt;• même état vu deux fois : arrêt&lt;br&gt;• 1 appel au partenaire, abandon à 3 s&lt;br&gt;• 1 s par contrôle interne" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="135" width="280" height="150" as="geometry"/></mxCell><mxCell id="par" value="Dans l&#x27;ordre, 1 à 4 : chacun seulement si le précédent n&#x27;a pas conclu" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3d85c6;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Arial;fontSize=11;fontColor=#3d85c6;verticalAlign=bottom;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="1120" height="230" as="geometry"/></mxCell><mxCell id="elig" value="&lt;b&gt;1 · Éligibilité&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;règles en code&lt;/i&gt;&lt;br&gt;E1 à E5 de la spec : contrat actif, cotisations, carence de 30 jours, délai de déclaration, garantie.&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;Interdit : chiffrer, juger les pièces ou la fraude&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="65" y="320" width="245" height="170" as="geometry"/></mxCell><mxCell id="pieces" value="&lt;b&gt;2 · Pièces justificatives&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;code ; lisibilité rendue par le Lecteur de pièces&lt;/i&gt;&lt;br&gt;Présence, lisibilité, type attendu ; adresse le complément que la Coordination lui confie.&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;Interdit : conclure, chiffrer, juger la fraude&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="325" y="320" width="245" height="170" as="geometry"/></mxCell><mxCell id="estim" value="&lt;b&gt;3 · Estimation&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;calcul en code&lt;/i&gt;&lt;br&gt;Justifié, retenu, moins la franchise, puis le plafond (point ambigu tranché).&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;Interdit : juger la fraude, revenir sur l&#x27;éligibilité&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="320" width="260" height="170" as="geometry"/></mxCell><mxCell id="af" value="&lt;b&gt;4 · Anti-fraude&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E2] [E3]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;seuils en code&lt;/i&gt;&lt;br&gt;Reçoit 8 données, dont le montant justifié, jamais l&#x27;identité ni l&#x27;IBAN. Indicateurs F1 à F4 ; si l&#x27;un est présent, un seul appel au partenaire.&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;Interdit : émettre un avis lui-même, relancer&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="320" width="280" height="190" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="recv" target="coord"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.02;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="elig"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="311" y="300"/><mxPoint x="285" y="300"/></Array></mxGeometry></mxCell><mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.26;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="pieces"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.77;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="estim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.98;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="af"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="849" y="310"/><mxPoint x="1020" y="310"/></Array></mxGeometry></mxCell><mxCell id="p0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="elig" target="pieces"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1" value="factures" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="pieces" target="estim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="estim" target="af"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="etat" value="État de la demande (mémoire de session) &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E2] [E3]&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="50" y="540" width="560" height="375" as="geometry"/></mxCell><mxCell id="s_dem" value="&lt;b&gt;demande&lt;/b&gt; : reçue, lecture seule" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#ffffff;strokeColor=#999999;fontSize=11;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="65" y="580" width="260" height="58" as="geometry"/></mxCell><mxCell id="s_eli" value="&lt;b&gt;eligibilite&lt;/b&gt; : résultat d&#x27;Éligibilité" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="580" width="260" height="58" as="geometry"/></mxCell><mxCell id="s_pie" value="&lt;b&gt;pieces&lt;/b&gt; : résultat de Pièces" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="650" width="260" height="58" as="geometry"/></mxCell><mxCell id="s_est" value="&lt;b&gt;estimation&lt;/b&gt; : résultat d&#x27;Estimation" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="650" width="260" height="58" as="geometry"/></mxCell><mxCell id="s_avi" value="&lt;b&gt;avis_fraude&lt;/b&gt; : résultat d&#x27;Anti-fraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="720" width="260" height="58" as="geometry"/></mxCell><mxCell id="s_iss" value="&lt;b&gt;issue&lt;/b&gt; : écrite par la Coordination" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#d9ead3;strokeColor=#2E6B3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="720" width="260" height="58" as="geometry"/></mxCell><mxCell id="s_ctl" value="&lt;b&gt;controle&lt;/b&gt; : bornes, marqueur, arret" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#d9ead3;strokeColor=#2E6B3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="790" width="260" height="58" as="geometry"/></mxCell><mxCell id="s_tra" value="&lt;b&gt;trace&lt;/b&gt; : une ligne par étape (agent, ecrit)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;verticalAlign=middle;spacingTop=0;rounded=0;fillColor=#d9ead3;strokeColor=#2E6B3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="790" width="260" height="58" as="geometry"/></mxCell><mxCell id="etat_n" value="Seule la Coordination lit et écrit ; aucun agent ne reçoit l&#x27;état complet ; jamais exposé par A2A." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="65" y="865" width="530" height="40" as="geometry"/></mxCell><mxCell id="lit" value="lit et range" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;startArrow=block;startFill=1;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="etat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="247"/><mxPoint x="40" y="595"/></Array></mxGeometry></mxCell><mxCell id="fF" value="Indicateur&lt;br&gt;F1 à F4 ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="930" y="545" width="180" height="90" as="geometry"/></mxCell><mxCell id="af_f" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="af" target="fF"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="regles" value="&lt;b&gt;Règles de décision (§ 10)&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;dans l&#x27;ordre, la première qui s&#x27;applique fixe l&#x27;issue : éligible ? pièces complètes ? montant nul ? avis anti-fraude ? plus de 10 000 € ? sinon acceptée" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="660" width="250" height="135" as="geometry"/></mxCell><mxCell id="f_non" value="non : avis non requis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fF" target="regles"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="590"/></Array></mxGeometry></mxCell><mxCell id="o_acc" value="&lt;b&gt;Acceptée&lt;/b&gt; · montant remboursé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="920" y="660" width="240" height="48" as="geometry"/></mxCell><mxCell id="o_ref" value="&lt;b&gt;Refusée&lt;/b&gt; · motif, conditions citées" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="920" y="718" width="240" height="48" as="geometry"/></mxCell><mxCell id="o_ges" value="&lt;b&gt;Escalade gestionnaire&lt;/b&gt; · motif" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="920" y="776" width="240" height="48" as="geometry"/></mxCell><mxCell id="o_cel" value="&lt;b&gt;Escalade cellule_fraude&lt;/b&gt; · motif" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="920" y="834" width="240" height="48" as="geometry"/></mxCell><mxCell id="r_o_acc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="regles" target="o_acc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r_o_ref" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="regles" target="o_ref"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r_o_ges" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="regles" target="o_ges"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r_o_cel" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="regles" target="o_cel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fiche" value="&lt;b&gt;Fiche de décision&lt;/b&gt; (§ 11) : issue, montant, motif, file, avis, mode dégradé, trace, arret" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="815" width="250" height="95" as="geometry"/></mxCell><mxCell id="filtre" value="&lt;b&gt;Filtre sortant&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E3]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Message neuf construit depuis une liste blanche : exactement 7 champs, dont 2 calculés (ancienneté, département). Validé contre un schéma strict ; en cas d&#x27;échec, rien ne part." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1215" y="135" width="395" height="120" as="geometry"/></mxCell><mxCell id="appel" value="&lt;b&gt;Appel unique&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E5]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;message/send, jeton Bearer ; marqueur d&#x27;appel écrit avant par la Coordination ; abandon à 3 s ; aucune relance (contrat § 6)." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1215" y="285" width="395" height="110" as="geometry"/></mxCell><mxCell id="valid" value="&lt;b&gt;Validation de la réponse&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E4]&lt;/b&gt;&lt;/font&gt;, cinq niveaux&lt;br&gt;1 · transport · 2 · enveloppe JSON-RPC · 3 · forme A2A (tâche terminée) · 4 · schéma (6 champs) · 5 · cohérence (même dossier, score de 0 à 1, niveau cohérent)&lt;br&gt;Au premier échec : réponse écartée, seule la raison est gardée." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1215" y="425" width="395" height="160" as="geometry"/></mxCell><mxCell id="dv" value="Avis conforme&lt;br&gt;et reçu en 3 s ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1322" y="605" width="180" height="85" as="geometry"/></mxCell><mxCell id="retenu" value="&lt;b&gt;Avis retenu&lt;/b&gt;&lt;br&gt;rangé dans avis_fraude ; règle 4 : faible poursuit, modéré gestionnaire, élevé cellule_fraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1215" y="720" width="190" height="110" as="geometry"/></mxCell><mxCell id="degr" value="&lt;b&gt;Mode dégradé (§ 9)&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E5]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;avis indisponible (délai, erreur, réponse écartée) :&lt;br&gt;• 1 500 € ou moins : la demande poursuit, marquée&lt;br&gt;• au-delà : escalade cellule_fraude&lt;br&gt;Les demandes sans indicateur ne sont jamais touchées." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1420" y="720" width="195" height="195" as="geometry"/></mxCell><mxCell id="tard" value="Réponse tardive : jamais lue ; jamais de rappel (doublon -32029)." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="845" width="190" height="70" as="geometry"/></mxCell><mxCell id="f_oui" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fF" target="filtre"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="590"/><mxPoint x="1185" y="195"/></Array></mxGeometry></mxCell><mxCell id="x1" value="7 champs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="filtre" target="appel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="valid" target="dv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x3" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6aa84f;strokeWidth=1.5;fontColor=#38761d;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dv" target="retenu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x4" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dv" target="degr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="card" value="&lt;b&gt;Agent Card&lt;/b&gt;&lt;br&gt;GET /.well-known/agent.json ; lue une fois au démarrage" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1670" y="135" width="290" height="90" as="geometry"/></mxCell><mxCell id="part" value="&lt;b&gt;Partenaire anti-fraude&lt;/b&gt;&lt;br&gt;agent A2A d&#x27;une autre entreprise : une boîte noire. Rend un avis consultatif : faible, modéré ou élevé." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1670" y="285" width="290" height="110" as="geometry"/></mxCell><mxCell id="tache" value="&lt;b&gt;Tâche A2A&lt;/b&gt;&lt;br&gt;état completed ; artefact data de 6 champs : référence, score, niveau, indicateurs, evaluation_id, version du modèle ; renvoyée, ou une erreur, à la validation" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1670" y="440" width="290" height="120" as="geometry"/></mxCell><mxCell id="cv2" value="&lt;b&gt;Contrat d&#x27;échange v2.0&lt;/b&gt;&lt;br&gt;• requête : 7 champs exactement&lt;br&gt;• réponse : 6 champs&lt;br&gt;• réponse garantie en 2 s ; abandon à 3 s&lt;br&gt;• un appel par dossier, aucune relance&lt;br&gt;• erreurs : 401, 503, -32700, -32600, -32601, -32602, -32029" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1670" y="600" width="290" height="200" as="geometry"/></mxCell><mxCell id="y1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="appel" target="part"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="part" target="tache"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tache" target="valid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="preuve" value="&lt;b&gt;Plan de preuve&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E1] [E2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;28 scénarios rejoués ; chaque fiche comparée au champ attendu ; chaque section remplie par son seul agent (niveau 2)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="950" width="600" height="90" as="geometry"/></mxCell><mxCell id="metr" value="&lt;b&gt;Métriques par agent&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E6]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;appels, échecs, latence, appels externes, calculés depuis la trace ; signaux d&#x27;équipe : étapes, bornes atteintes, issues, part en mode dégradé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="650" y="950" width="600" height="90" as="geometry"/></mxCell><mxCell id="journal" value="&lt;b&gt;Journal des ajustements&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E6]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;chaque changement provoqué par l&#x27;épreuve : scénario, signal, valeur avant et après, résultat du rejeu, commit (niveau 2)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="950" width="710" height="90" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Code (Coordination, liaison)" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="1065" width="205" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#45818e&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Agent de lecture" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="245" y="1065" width="128" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#3d85c6&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Agent de contrôle" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="384" y="1065" width="135" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Bornes, mode dégradé" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="528" y="1065" width="154" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Partenaire externe" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="692" y="1065" width="141" height="26" as="geometry"/></mxCell><mxCell id="leg5" value="&lt;font color=&quot;#bf9000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Escalade humaine" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="844" y="1065" width="128" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="Pointillé vert : appel avec ses entrées · trait plein : résultat ou données · pointillé gris : échange avec le partenaire, à travers la frontière de confiance : tout ce qui la franchit est filtré ou validé · [E1] à [E6] : exigences tenues par le bloc" style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1101" width="1300" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>