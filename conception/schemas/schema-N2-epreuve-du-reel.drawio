<mxfile host="app.diagrams.net" type="device"><diagram id="schema-N2-epreuve-du-reel" name="Niveau 2 · Épreuve du réel"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · L&#x27;épreuve du réel : rejouer, observer, ajuster · Niveau 2" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="st" value="Chaque scénario de eval/scenarios.jsonl est rejoué par traiter_lot avec un partenaire simulé ; tout écart provoque un seul ajustement du chantier 1, consigné, puis un nouveau rejeu." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1820" height="22" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;1 · Rejouer&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E6]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;un scénario par traiter_lot, partenaire simulé réglé par le scénario" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="320" height="110" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2 · Observer&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E6]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;issue, trace (agent, ecrit), métriques par agent, durées" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="320" height="110" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3 · Comparer&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E6]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;au champ attendu et aux invariants : conforme ou écart" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="770" y="100" width="320" height="110" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4 · Ajuster&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E6]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;chantier 1 : une borne, une frontière ou un routage ; un seul changement à la fois" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1140" y="100" width="320" height="110" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5 · Consigner&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E6]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;journal : scénario, signal, avant, après, rejeu, commit" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1510" y="95" width="340" height="125" as="geometry"/></mxCell><mxCell id="l_b1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_ret" value="rejeu des 28 scénarios et des tests unitaires, jusqu&#x27;à ce que tous les critères tiennent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1680" y="245"/><mxPoint x="190" y="245"/></Array></mxGeometry></mxCell><mxCell id="bouchon" value="Partenaire simulé fourni (external_agent)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="280" width="330" height="300" as="geometry"/></mxCell><mxCell id="m0" value="normal · NOM, AF, BCL" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;arcSize=50;fillColor=#f3f3f3;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="320" width="290" height="42" as="geometry"/></mxCell><mxCell id="m1" value="lent · 5 s, au-delà des 3 s · PAN-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;arcSize=50;fillColor=#f3f3f3;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="375" width="290" height="42" as="geometry"/></mxCell><mxCell id="m2" value="invalide · 7 variantes · INV" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;arcSize=50;fillColor=#f3f3f3;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="430" width="290" height="42" as="geometry"/></mxCell><mxCell id="m3" value="panne · PAN-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;arcSize=50;fillColor=#f3f3f3;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="485" width="290" height="42" as="geometry"/></mxCell><mxCell id="bouchon_n" value="Piloté par /_sim/* et scripts/partner_ctl.py (fournis) ; lancé par la suite d&#x27;acceptance et la mesure." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="540" width="290" height="35" as="geometry"/></mxCell><mxCell id="rejeux" value="&lt;b&gt;Combien de rejeux ?&lt;/b&gt;&lt;br&gt;Un seul suffit pour juger une issue : aucun LLM dans la décision et un partenaire simulé déterministe. Les scénarios de panne sont rejoués 5 fois pour les durées : PAN-02 de 3,021 à 3,033 s, face aux 10 s." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="330" height="165" as="geometry"/></mxCell><mxCell id="k0" value="&lt;b&gt;Cas nominaux · NOM-01 à 11&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E1] [E2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;signal : issue, trace, étapes, appels externes&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#38761d&quot;&gt;&lt;b&gt;attendu : 11 fiches conformes ; chaque section remplie par son seul agent ; 0 appel au partenaire&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;mesuré le 08/10&lt;/b&gt; : 11/11, 0 appel" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#3d85c6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="280" width="355" height="235" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;Rangement hors section · test unitaire&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;signal : la Coordination tente de ranger un résultat dans la section d&#x27;un autre agent&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#38761d&quot;&gt;&lt;b&gt;attendu : erreur de droits ; aucun agent ne reçoit l&#x27;état complet&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;mesuré le 08/10&lt;/b&gt; : test unitaire vert" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#3d85c6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="280" width="355" height="235" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;Données sensibles · test unitaire&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E3]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;signal : le message reçu par le partenaire simulé (son journal)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#38761d&quot;&gt;&lt;b&gt;attendu : exactement 7 champs ; ni nom, ni e-mail, ni IBAN, ni description&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;mesuré le 08/10&lt;/b&gt; : 7 champs, aucune donnée personnelle (AF-01 à 07)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#3d85c6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1130" y="280" width="355" height="235" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;Anti-fraude · AF-01 à 07&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E1] [E3]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;signal : appels externes, échecs, message envoyé, avis&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#38761d&quot;&gt;&lt;b&gt;attendu : 7 appels, 0 échec ; bon niveau et bonne issue (AF-03 : avis faible mais plus de 10 000 €, escalade)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;mesuré le 08/10&lt;/b&gt; : 7/7, 7 appels, 0 échec" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#3d85c6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1500" y="280" width="355" height="235" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;Réponses invalides · INV-01 à 07&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E4] [E5]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;signal : niveau de rejet et raison, avis, mode dégradé&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#38761d&quot;&gt;&lt;b&gt;attendu : chacune écartée à son niveau, rien recopié ; 1 500 € ou moins acceptée en mode dégradé, au-delà cellule_fraude&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;mesuré le 08/10&lt;/b&gt; : 7/7 ; schema ×3, incoherence ×2, non JSON, enveloppe" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#3d85c6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="535" width="355" height="235" as="geometry"/></mxCell><mxCell id="k5" value="&lt;b&gt;Partenaire en panne · PAN-01, lot de 5&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E5] [E6]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;signal : appels externes, échecs, issues du lot&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#38761d&quot;&gt;&lt;b&gt;attendu : 2 appels, 2 échecs, 0 relance ; 0401 et 0405 non touchés&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;mesuré le 08/10&lt;/b&gt; : 5/5 à chacun des 5 rejeux ; 2 appels, 2 échecs" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#3d85c6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="535" width="355" height="235" as="geometry"/></mxCell><mxCell id="k6" value="&lt;b&gt;Partenaire lent · PAN-02, 5 s, lot de 3&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E5] [E6]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;signal : durée de chaque appel, de chaque demande, du lot&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#38761d&quot;&gt;&lt;b&gt;attendu : abandon à 3 s au plus ; chaque demande sous 10 s ; lot d&#x27;environ 3 s, et non 6&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;mesuré le 08/10&lt;/b&gt; : 3/3 ; lot de 3,02 à 3,03 s sur 5 rejeux" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#3d85c6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1130" y="535" width="355" height="235" as="geometry"/></mxCell><mxCell id="k7" value="&lt;b&gt;Piège à boucle · BCL-01&lt;/b&gt; &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;[E1] [E6]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;signal : longueur de la trace, arret&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#38761d&quot;&gt;&lt;b&gt;attendu : escalade avec arret ; trace de 8 étapes au plus&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;mesuré le 08/10&lt;/b&gt; : escalade, arret etat_repete, trace de 4 étapes" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#ffffff;strokeColor=#3d85c6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1500" y="535" width="355" height="235" as="geometry"/></mxCell><mxCell id="totaux" value="&lt;b&gt;Les 28 scénarios (34 demandes) : attendu, et mesuré le 08/10 (34/34 conformes)&lt;/b&gt;&lt;br&gt;16 acceptées · 7 refusées · 5 escalades gestionnaire (dont BCL-01) · 6 escalades cellule_fraude&lt;br&gt;11 en mode dégradé · 1 borne atteinte · 18 appels au partenaire, jamais deux par dossier · 11 échecs de l&#x27;agent antifraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="900" height="120" as="geometry"/></mxCell><mxCell id="ligne" value="&lt;b&gt;Une ligne réelle du journal (entrée 8, sur 8 consignées)&lt;/b&gt;&lt;br&gt;mesure des bornes → l&#x27;appel réussi le plus long dure 0,104 s : le seuil de 0,1 s était trop court → seuil porté à 0,15 s, réserve de la fiche de 0,5 à 0,4 s (38 ms de dépassement mesuré) → rejeu : 56/56, 342 tests verts → commit." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="800" width="900" height="120" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Étape de contrôle" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="945" width="135" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Ajustement du chantier 1" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="175" y="945" width="180" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#3d85c6&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Scénario ou test" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="364" y="945" width="128" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Partenaire simulé" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="503" y="945" width="135" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>